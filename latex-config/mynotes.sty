% 9. dhkdiagram v3: split/merge + line annotations + v2 compatibility
% Add this entire block AFTER the current section 8 in mynotes.sty.
% Nothing in dhkbranch, dhkdir, or dhksmry needs to change.
%
% Syntax (one instruction per physical line):
%   node ID (row,col) :: visible label // optional second line
%   edge A -> B :: straight    (A to B)
%   edge A -> B :: HV          (horizontal, then vertical)
%   edge A -> B :: VH          (vertical, then horizontal)
%   edge A <- B :: HV          (B to A)
%   edge A <-> B :: HV         (both arrows)
%   edge A -- B :: HV          (plain line)
%   edge A -> B :: CLI Command    (straight edge with annotation)
%   edge A -> B :: VH // explanation (route and annotation)
%   split parent -> a, b, c :: branch explanation
%   merge a, b, c -> dest :: merge explanation
% Notes: split and merge connect adjacent rows, with a shared horizontal rail.
% Existing v2 edge/node syntax is supported without modifications.
% Default edge shape: straight.  Row/column indexing starts at 1.
% Use \dhkdiagramspacing{8mm}{3mm} to set global H/V gaps.
% NOTE: :: and // are reserved delimiters inside labels.
% ================================================================
\RequirePackage{tikz}
\RequirePackage{fancyvrb}
\RequirePackage{adjustbox}
\usetikzlibrary{arrows.meta,calc,backgrounds}
