\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mynotes}[2026/10/18 Personal Notes v12]
% 1. Required packages
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}
\RequirePackage{minted}
\RequirePackage{xparse}
\RequirePackage{fancyvrb}
\RequirePackage{xurl}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{mathtools}
% 2. Paragraph formatting (unchanged)
\setlength{\parindent}{0pt}
\setlength{\parskip}{4mm}
% 3. Note: a consistent full text-width box
% Replaces both the old \dhknt and variable-looking notes.
\newtcolorbox{dhknote}{%
  width=\linewidth,
  colback=gray!10,
  colframe=gray!30,
  boxrule=0.4pt,
  arc=1mm,
  boxsep=1mm,
  left=2mm,
  right=2mm,
  top=2mm,
  bottom=2mm,
  before skip=2mm,
  after skip=2mm,
  before upper={\setlength{\parindent}{0pt}}
}
% 4. Minted Python highlighting (unchanged)
\setminted{
  style=vscode-notes,
  fontsize=\small,
  breaklines=true,
  breakanywhere=true,
  linenos=false,
  numbersep=10pt,
  tabsize=4,
  autogobble=true
}
\newminted[dhkcode]{vscodepython}{%
  listparameters={\setlength{\topsep}{1mm}}
}
% 5. Shell blocks and robust inline monospaced text
% Note: \zsh accepts _, backslash paths, #, &, and braces in
% section headings. Literal percent must be written as \% because TeX
% removes comments before a macro can read its argument.
\newcommand{\dhkcell}[1]{\makebox[\fontcharwd\font`0][c]{#1}}
\providecommand{\ra}{\dhkcell{\ensuremath{\rightarrow}}}
\providecommand{\la}{\dhkcell{\ensuremath{\leftarrow}}}
\providecommand{\ua}{\dhkcell{\ensuremath{\uparrow}}}
\providecommand{\da}{\dhkcell{\ensuremath{\downarrow}}}
\providecommand{\lra}{\dhkcell{\ensuremath{\leftrightarrow}}}
\providecommand{\uda}{\dhkcell{\ensuremath{\updownarrow}}}
\providecommand{\Ra}{\dhkcell{\ensuremath{\Rightarrow}}}
\providecommand{\Da}{\dhkcell{\ensuremath{\Downarrow}}}
% This argument is read normally, so it also works inside
% \section, \subsection, and \subsubsection.
% The function converts tokens to literal text and removes
% the extra space inserted after control words by detokenize.
\ExplSyntaxOn
\tl_new:N \l_dhk_zsh_inline_tl
\cs_generate_variant:Nn \tl_replace_all:Nnn {NVV}
\cs_new_protected:Npn \dhk_zsh_inline:n #1
  {
    \tl_set:Nx \l_dhk_zsh_inline_tl {#1}
    \regex_replace_all:nnN { (\\[A-Za-z]+) \s } { \1 } \l_dhk_zsh_inline_tl
    \regex_replace_all:nnN { \\ \% } { \% } \l_dhk_zsh_inline_tl
    \tl_set:Nx \l_tmpa_tl {\char_generate:nn {35}{12}\char_generate:nn {35}{12}}
    \tl_set:Nx \l_tmpb_tl {\char_generate:nn {35}{12}}
    \tl_replace_all:NVV \l_dhk_zsh_inline_tl \l_tmpa_tl \l_tmpb_tl
    \texttt{\tl_use:N \l_dhk_zsh_inline_tl}
  }
\cs_new:Npn \zsh #1 { \exp_not:n { \dhkZshText {\detokenize{#1}} } }
\cs_new_protected:Npn \dhkZshText #1 { \dhk_zsh_inline:n {#1} }
\ExplSyntaxOff
% Fancyvrb centered key, preserves original small-font layout.
\makeatletter
\define@key{FV}{centered}[true]{%
  \def\FancyVerbFormatLine##1{%
    \hbox to \linewidth{\hfil ##1\hfil}%
  }%
}
\makeatother
% Literal shell/JSON/code: ALL input chars remain literal.
% In particular \\, {, }, _, #, $, %, & are not parsed.
\DefineVerbatimEnvironment{dhkzsh}{Verbatim}{%
  fontsize=\small,
  vspace=1mm
}
\DefineVerbatimEnvironment{dhkzshcode}{Verbatim}{%
  fontsize=\small,
  vspace=1mm
}
% Optional old-style arrow macros inside a verbatim block.
% This separate environment retains the original commandchars
% behaviour; use only if raw JSON/braces/backslashes aren't needed.
\DefineVerbatimEnvironment{dhksmry}{Verbatim}{%
  commandchars=\\\{\},
  codes={\catcode`\$=3},
  fontsize=\small
}

% ============================================================
% 6. dhktable v14: auto-detected columns + //* intra-cell breaks
% ============================================================
% Same Markdown-like syntax; table width remains \linewidth.
% Header is bold; all BODY cells use \normalfont\ttfamily\small.
% Example cell: first line //* second line (breaks INSIDE one cell).
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\ExplSyntaxOn
\ior_new:N \g_dhk_table_ior
\seq_new:N \l_dhk_table_cells_seq
\tl_new:N \l_dhk_table_line_tl
\tl_new:N \l_dhk_table_cell_tl
\tl_new:N \l_dhk_table_body_tl
\tl_new:N \l_dhk_table_colspec_tl
\int_new:N \l_dhk_table_stage_int
\int_new:N \l_dhk_table_columns_int
\cs_generate_variant:Nn \seq_set_split:Nnn {NnV}
\cs_generate_variant:Nn \tl_put_right:Nn {NV}
% Turn //* into a real line break inside a tabularx X-column.
% Note: do NOT use a table-row \\ here; that would create another row.
\cs_new_protected:Npn \dhk_table_prepare_cell:
 {
  \tl_replace_all:Nnn \l_dhk_table_cell_tl {//*} {\newline}
 }
\cs_new_protected:Npn \dhk_table_row:n #1
 {
  \tl_set:Nn \l_dhk_table_line_tl {#1}
  \tl_trim_spaces:N \l_dhk_table_line_tl
  \seq_set_split:NnV \l_dhk_table_cells_seq {|} \l_dhk_table_line_tl
  \seq_pop_left:NN \l_dhk_table_cells_seq \l_tmpa_tl
  \seq_pop_right:NN \l_dhk_table_cells_seq \l_tmpa_tl
  % Determine column count from actual rows (not the |:---| divider).
  \int_set:Nn \l_dhk_table_columns_int
   {\int_max:nn {\l_dhk_table_columns_int} {\seq_count:N \l_dhk_table_cells_seq}}
  \seq_map_indexed_inline:Nn \l_dhk_table_cells_seq
   {
    \int_compare:nNnT {##1} > {1}
     {\tl_put_right:Nn \l_dhk_table_body_tl {&}}
    \tl_set:Nn \l_dhk_table_cell_tl {##2}
    \tl_trim_spaces:N \l_dhk_table_cell_tl
    \dhk_table_prepare_cell:
    \int_compare:nNnTF {\l_dhk_table_stage_int} = {2}
     {
      \tl_put_right:Nn \l_dhk_table_body_tl
       {\begingroup\normalfont\ttfamily\small}
      \tl_put_right:NV \l_dhk_table_body_tl \l_dhk_table_cell_tl
      \tl_put_right:Nn \l_dhk_table_body_tl {\endgroup}
     }
     {
      \tl_put_right:Nn \l_dhk_table_body_tl {\begingroup\bfseries}
      \tl_put_right:NV \l_dhk_table_body_tl \l_dhk_table_cell_tl
      \tl_put_right:Nn \l_dhk_table_body_tl {\endgroup}
     }
   }
  \tl_put_right:Nn \l_dhk_table_body_tl {\\}
 }
\cs_new_protected:Npn \dhk_table_process:n #1
 {
  \tl_if_blank:nF {#1}
   {
    \int_case:nnF {\l_dhk_table_stage_int}
     {
      {0}{\dhk_table_row:n {#1}
          \tl_put_right:Nn \l_dhk_table_body_tl {\midrule}
          \int_set:Nn \l_dhk_table_stage_int {1}}
      {1}{\int_set:Nn \l_dhk_table_stage_int {2}}
      {2}{\dhk_table_row:n {#1}}
     }{}
   }
 }
\cs_new_protected:Npn \dhk_table_begin:n #1
 {\begin{tabularx}{\linewidth}{#1}}
\cs_new_protected:Npn \dhk_table_render:
 {
  \par\smallskip\noindent
  \begingroup
  \footnotesize
  \renewcommand{\arraystretch}{1.5}
  \int_zero:N \l_dhk_table_stage_int
  \int_zero:N \l_dhk_table_columns_int
  \tl_clear:N \l_dhk_table_body_tl
  \ior_open:Nn \g_dhk_table_ior {\jobname-dhktable.tmp}
  \char_set_catcode_other:n {35}
  \char_set_catcode_other:n {36}
  \char_set_catcode_other:n {37}
  \char_set_catcode_other:n {38}
  \char_set_catcode_other:n {95}
  \char_set_catcode_other:n {94}
  \char_set_catcode_other:n {126}
  \char_set_catcode_other:n {92}
  \char_set_catcode_other:n {123}
  \char_set_catcode_other:n {125}
  \ior_map_inline:Nn \g_dhk_table_ior {\dhk_table_process:n {##1}}
  \ior_close:N \g_dhk_table_ior
  % Auto-generated tabularx preamble: X for EVERY detected column.
  \tl_set:Nn \l_dhk_table_colspec_tl {@{}}
  \int_step_inline:nn {\l_dhk_table_columns_int}
   {\tl_put_right:Nn \l_dhk_table_colspec_tl
     {>{\raggedright\arraybackslash}X}}
  \tl_put_right:Nn \l_dhk_table_colspec_tl {@{}}
  \int_compare:nNnTF {\l_dhk_table_columns_int} > {0}
   {
    \exp_args:NV \dhk_table_begin:n \l_dhk_table_colspec_tl
    \toprule
    \tl_use:N \l_dhk_table_body_tl
    \bottomrule
    \end{tabularx}
   }
   {\PackageWarning{mynotes}{Empty~dhktable~environment}}
  \endgroup
  \par\smallskip
 }
\cs_new_eq:NN \dhktablerender \dhk_table_render:
\ExplSyntaxOff
\newenvironment{dhktable}{%
  \VerbatimEnvironment
  \begin{VerbatimOut}{\jobname-dhktable.tmp}%
}{%
  \end{VerbatimOut}%
  \dhktablerender
}



% ==================================================
% 7. Automatic tree diagrams
% ==================================================
%
% dhktree          : Vertical tree
% dhktreeh         : Horizontal tree
% dhktreediagonal  : Diagonal tree
% dhkdir           : Directory-style tree
%
% Common syntax:
%   >    : Depth
%   ::   : Description
%   //   : Manual line break
%
% ==================================================


% ==================================================
% 7.1 Packages
% ==================================================

\RequirePackage{forest}
\RequirePackage{fancyvrb}
\RequirePackage{adjustbox}
\RequirePackage{dirtree}


% ==================================================
% 7.2 Forest styles — Compact and clean layout
% ==================================================

\forestset{
  dhktreevertical/.style={for tree={
    grow=270,
    l sep=10mm,
    s sep=7mm,
    anchor=center,
    align=center,
    inner sep=2pt,
    edge={thick},
    edge path={
      \noexpand\path[\forestoption{edge}]
      (!u.south)
      -- ++(0,-4mm)
      -| (.north)
      \forestoption{edge label};}
  }},
  dhktreeh/.style={for tree={
    grow=0,
    l sep=12mm,
    s sep=7mm,
    anchor=center,
    align=center,
    inner sep=2pt,
    edge={thick},
    edge path={
      \noexpand\path[\forestoption{edge}]
      (!u.east)
      -- ++(4mm,0)
      |- (.west)
      \forestoption{edge label};}
  }},
  dhktreediagonal/.style={for tree={
    grow=270,
    l sep=12mm,
    s sep=7mm,
    anchor=center,
    align=center,
    inner sep=2pt,
    edge={thick}
  }}
}


% ==================================================
% 7.3 Automatic Forest width adjustment
% ==================================================
%
% Must be defined outside \ExplSyntaxOn.
%
% "max width" contains a space.
%
% ==================================================

\newcommand{\dhktreefitbegin}{%
  \begin{adjustbox}{max width=\linewidth}%
}


% ==================================================
% 7.4 Original tree parser
% ==================================================

\ExplSyntaxOn

\ior_new:N \g_dhktree_in_ior

\tl_new:N \l_dhktree_content_tl
\tl_new:N \l_dhktree_line_tl
\tl_new:N \l_dhktree_name_tl
\tl_new:N \l_dhktree_desc_tl
\tl_new:N \l_dhktree_edge_tl

\seq_new:N \l_dhktree_parts_seq

\int_new:N \l_dhktree_previous_int
\int_new:N \l_dhktree_depth_int
\int_new:N \l_dhktree_count_int

\bool_new:N \l_dhktree_started_bool

\tl_new:N \l_dhktree_orientation_tl
\tl_new:N \l_dhktree_edge_style_tl

\cs_generate_variant:Nn \seq_set_split:Nnn { NnV, NVV }
\cs_generate_variant:Nn \regex_extract_once:nnNTF { nVNTF }
\cs_generate_variant:Nn \tl_put_right:Nn { Nx }


% ==================================================
% 7.5 Parse Forest node
% ==================================================

\cs_new_protected:Npn \dhktree_parse:n #1
 {
  \tl_set:Nn \l_dhktree_line_tl {#1}
  \tl_trim_spaces:N \l_dhktree_line_tl

  \tl_if_blank:VF \l_dhktree_line_tl
   {
    \int_zero:N \l_dhktree_depth_int

    \regex_extract_once:nVNTF
      {\A(>+)}
      \l_dhktree_line_tl
      \l_dhktree_parts_seq
     {
      \int_set:Nn \l_dhktree_depth_int
       {
        \tl_count:e
         {
          \seq_item:Nn \l_dhktree_parts_seq {2}
         }
       }
     }
     {}

    \regex_replace_once:nnN
      {\A>+\s*}
      {}
      \l_dhktree_line_tl

    % Edge label: =>

    \tl_set:Nx \l_tmpa_tl {\tl_to_str:n {=>}}

    \seq_set_split:NVV
      \l_dhktree_parts_seq
      \l_tmpa_tl
      \l_dhktree_line_tl

    \seq_pop_left:NN
      \l_dhktree_parts_seq
      \l_dhktree_line_tl

    \seq_if_empty:NTF \l_dhktree_parts_seq
      {\tl_clear:N \l_dhktree_edge_tl}
      {
       \seq_pop_left:NN
         \l_dhktree_parts_seq
         \l_dhktree_edge_tl
      }

    \tl_trim_spaces:N \l_dhktree_edge_tl

    % Description: ::

    \tl_set:Nx \l_tmpa_tl {\tl_to_str:n {::}}

    \seq_set_split:NVV
      \l_dhktree_parts_seq
      \l_tmpa_tl
      \l_dhktree_line_tl

    \seq_pop_left:NN
      \l_dhktree_parts_seq
      \l_dhktree_name_tl

    \tl_trim_spaces:N \l_dhktree_name_tl

    \seq_if_empty:NTF \l_dhktree_parts_seq
      {\tl_clear:N \l_dhktree_desc_tl}
      {
       \seq_pop_left:NN
         \l_dhktree_parts_seq
         \l_dhktree_desc_tl
      }

    \tl_trim_spaces:N \l_dhktree_desc_tl

    % Close completed branches

    \bool_if:NT \l_dhktree_started_bool
     {
      \int_step_inline:nn
       {
        \int_max:nn
         {0}
         {
          \l_dhktree_previous_int
          -
          \l_dhktree_depth_int
          +
          1
         }
       }
       {
        \tl_put_right:Nn
          \l_dhktree_content_tl
          {]}
       }
     }

    % Create node

    \tl_put_right:Nx \l_dhktree_content_tl
     {
      [
       {
        \exp_not:N \dhktreebox
         {\exp_not:V \l_dhktree_name_tl}
         {\exp_not:V \l_dhktree_desc_tl}
       }
     }

    % Edge label

    \tl_if_blank:VF \l_dhktree_edge_tl
     {
      \tl_put_right:Nx \l_dhktree_content_tl
       {
        ,edge\c_space_tl label=
         {
          node[
            midway,
            fill=white,
            inner\c_space_tl sep=1pt,
            font=\exp_not:N \scriptsize
          ]
          {
           \exp_not:V \l_dhktree_edge_tl
          }
         }
       }
     }

    % Orientation

    \bool_if:NF \l_dhktree_started_bool
     {
      \tl_put_right:Nx \l_dhktree_content_tl
       {
        ,\exp_not:V \l_dhktree_orientation_tl
       }
     }

    \int_set_eq:NN
      \l_dhktree_previous_int
      \l_dhktree_depth_int

    \bool_set_true:N \l_dhktree_started_bool
   }
 }


% ==================================================
% 7.6 Original Forest renderer
% ==================================================

\cs_new_protected:Npn \dhktree_render:n #1
 {
  \group_begin:

  \tl_clear:N \l_dhktree_content_tl
  \int_zero:N \l_dhktree_previous_int
  \bool_set_false:N \l_dhktree_started_bool

  \str_case:nnF {#1}
   {
    {horizontal}
     {
      \tl_set:Nn
        \l_dhktree_orientation_tl
        {dhktreeh}
     }

    {diagonal}
     {
      \tl_set:Nn
        \l_dhktree_orientation_tl
        {dhktreediagonal}
     }
   }
   {
    \tl_set:Nn
      \l_dhktree_orientation_tl
      {dhktreevertical}
   }

  \ior_open:Nn
    \g_dhktree_in_ior
    {\jobname-dhktree.tmp}

  \ior_str_map_inline:Nn
    \g_dhktree_in_ior
   {
    \dhktree_parse:n {##1}
   }

  \ior_close:N \g_dhktree_in_ior

  \bool_if:NT \l_dhktree_started_bool
   {
    \int_step_inline:nn
      {\l_dhktree_previous_int + 1}
     {
      \tl_put_right:Nn
        \l_dhktree_content_tl
        {]}
     }

    \par\smallskip\noindent

    \dhktreefitbegin
      \exp_args:NV
        \Forest
        \l_dhktree_content_tl
    \end{adjustbox}

    \par\smallskip
   }

  \group_end:
 }


% ==================================================
% 7.7 Manual line breaks
% ==================================================

\seq_new:N \l_dhktree_breaks_seq

\cs_new_protected:Npn \dhktree_print_lines:n #1
 {
  \seq_set_split:Nnn
    \l_dhktree_breaks_seq
    {//}
    {#1}

  \seq_map_indexed_inline:Nn
    \l_dhktree_breaks_seq
   {
    \int_compare:nNnT
      {##1} > {1}
     {
      \tabularnewline
     }

    \tl_trim_spaces:n {##2}
   }
 }


% ==================================================
% 7.8 Original Forest node box
% ==================================================

\cs_new_protected:Npn \dhktreebox #1#2
 {
  \begin{tabular}{@{}c@{}}

   \dhktree_print_lines:n {#1}

   \tl_if_blank:nF {#2}
    {
     \tabularnewline
     \footnotesize
     \dhktree_print_lines:n {#2}
    }

  \end{tabular}
 }


% ==================================================
% 7.9 Original public renderer
% ==================================================

\cs_new_eq:NN
  \dhktreerender
  \dhktree_render:n


% ==================================================
% 7.10 NEW: Directory tree parser
% ==================================================
%
% Uses dirtree instead of forest.
%
% Special characters in file paths are read
% as literal strings by \ior_str_map_inline.
%
% ==================================================

\tl_new:N \l_dhkdir_content_tl

\cs_new_protected:Npn \dhkdir_parse:n #1
 {
  \tl_set:Nn
    \l_dhktree_line_tl
    {#1}

  \tl_trim_spaces:N
    \l_dhktree_line_tl

  \tl_if_blank:VF \l_dhktree_line_tl
   {
    % ----------------------------------------------
    % 1. Calculate depth from > characters
    % ----------------------------------------------

    \int_zero:N \l_dhktree_depth_int

    \regex_extract_once:nVNTF
      {\A(>+)}
      \l_dhktree_line_tl
      \l_dhktree_parts_seq
     {
      \int_set:Nn
        \l_dhktree_depth_int
       {
        \tl_count:e
         {
          \seq_item:Nn
            \l_dhktree_parts_seq
            {2}
         }
       }
     }
     {}

    \regex_replace_once:nnN
      {\A>+\s*}
      {}
      \l_dhktree_line_tl

    % ----------------------------------------------
    % 2. Split filename and description at ::
    % ----------------------------------------------

    \tl_set:Nx \l_tmpa_tl
      {\tl_to_str:n {::}}

    \seq_set_split:NVV
      \l_dhktree_parts_seq
      \l_tmpa_tl
      \l_dhktree_line_tl

    \seq_pop_left:NN
      \l_dhktree_parts_seq
      \l_dhktree_name_tl

    \tl_trim_spaces:N
      \l_dhktree_name_tl

    \seq_if_empty:NTF
      \l_dhktree_parts_seq
     {
      \tl_clear:N \l_dhktree_desc_tl
     }
     {
      \seq_pop_left:NN
        \l_dhktree_parts_seq
        \l_dhktree_desc_tl
     }

    \tl_trim_spaces:N
      \l_dhktree_desc_tl

    % ----------------------------------------------
    % 3. Convert to dirtree syntax
    %
    % Input:
    %   >data/
    %   >>train.csv :: Training dataset
    %
    % Conversion:
    %   .2 {data/}.
    %   .3 {train.csv + description}.
    %
    % IMPORTANT:
    % \c_space_tl is required by dirtree's parser.
    % ----------------------------------------------

    \tl_put_right:Nx
      \l_dhkdir_content_tl
     {
      .
      \int_eval:n
       {
        \l_dhktree_depth_int + 1
       }
      \c_space_tl
       {
        \exp_not:N \dhkdirbox
         {
          \exp_not:V \l_dhktree_name_tl
         }
         {
          \exp_not:V \l_dhktree_desc_tl
         }
       }
      .
      \c_space_tl
     }
   }
 }

% ==================================================
% 7.11 dhkdir v6: unified spacing + [in=N] option
%     >, >>, ... : original hierarchy (unchanged in ordinary mode)
%     | text     : connect preceding node vertically to text
%     |          : optional extra spacing before next linked node
%     //         : manual line break inside a node
%     ::         : smaller description
%     ->         : visible right arrow
%     @          : attachment at the following character's START (hidden)
%                  e.g. /Users/user/@Desktop/python/project or -> @module
% ==================================================
\RequirePackage{tikz}
\ExplSyntaxOff
\usetikzlibrary{calc}
\ExplSyntaxOn
% Shared [in=N] option parser for dhkdir and dhkdiagram.
% Nonnegative decimals are accepted; unrecognised options warn and use zero.
\dim_new:N \l_dhkvisual_indent_dim
\seq_new:N \l_dhkvisual_indent_match_seq
\cs_new_protected:Npn \dhkvisual_set_indent:n #1
 {
  \dim_zero:N \l_dhkvisual_indent_dim
  \tl_set:Nn \l_tmpa_tl {#1}
  \tl_trim_spaces:N \l_tmpa_tl
  \tl_if_blank:VF \l_tmpa_tl
   {
    \regex_extract_once:nVNTF
     {\A in \s* = \s* ([0-9]+ (?: \. [0-9]+ )?) \Z}
     \l_tmpa_tl \l_dhkvisual_indent_match_seq
     {\dim_set:Nn \l_dhkvisual_indent_dim
       {\seq_item:Nn \l_dhkvisual_indent_match_seq {2} em}}
