      \seq_set_split:NVV \l_dhkdirx_parts_seq \l_tmpa_tl \l_dhkdirx_line_tl
      \seq_pop_left:NN \l_dhkdirx_parts_seq \l_dhkdirx_name_tl
      \tl_trim_spaces:N \l_dhkdirx_name_tl
