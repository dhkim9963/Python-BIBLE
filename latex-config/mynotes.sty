              font=\normalfont\ttfamily\small]
         (\l_dhkdirx_new_node_tl)
         at ($ (\l_dhkdirx_last_node_tl.south~west) +
           (\dim_use:N \l_dhkdirx_horizontal_delta_dim,
            -\dim_use:N \l_dhkdirx_vertical_gap_dim) $)
         {\dhkdirx_label:};
