         {dhkdirprefix-\int_use:N \l_dhkdirx_serial_int}
        \node[overlay,anchor=west,inner~sep=0pt,outer~sep=0pt,
              font=\normalfont\ttfamily\small,opacity=0]
         (\l_dhkdirx_prefix_node_tl)
         at (\l_dhkdirx_new_node_tl.north~west)
         {\exp_args:NV \dhkdirx_print_inline:n \l_dhkdirx_prefix_tl};
        \pgfextractx{\l_dhkdirx_attach_dim}
         {\pgfpointdiff
           {\pgfpointanchor{\l_dhkdirx_new_node_tl}{north~west}}
           {\pgfpointanchor{\l_dhkdirx_prefix_node_tl}{east}}}
