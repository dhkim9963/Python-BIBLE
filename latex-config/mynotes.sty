% Print literal text as monospace; allow // inside a single node.
% Replace visible -> with a real math arrow, without interpreting
% arbitrary backslashes/underscores from filenames as TeX commands.
\cs_new_protected:Npn \dhkdiagram_print_line:n #1
 {
  \tl_set:Nn \l_tmpa_tl {#1}
  \tl_trim_spaces:N \l_tmpa_tl
  \tl_replace_all:Nnn \l_tmpa_tl {->} {\ensuremath{\rightarrow}}
  \tl_use:N \l_tmpa_tl
 }
\cs_new_protected:Npn \dhkdiagram_print_label:n #1
 {
  \seq_set_split:Nnn \l_dhkdiagram_label_lines_seq {//} {#1}
  \begin{tabular}{@{}l@{}}
   \ttfamily\small
   \seq_map_indexed_inline:Nn \l_dhkdiagram_label_lines_seq
    {
     \int_compare:nNnT {##1} > {1} {\tabularnewline}
     \ttfamily\small\dhkdiagram_print_line:n {##2}
    }
  \end{tabular}
 }

\cs_new_protected:Npn \dhkdiagram_scan:n #1
 {
  \tl_set:Nn \l_dhkdiagram_left_tl {#1}
  \tl_trim_spaces:N \l_dhkdiagram_left_tl
  \tl_if_blank:VF \l_dhkdiagram_left_tl
   {
    \tl_set:Nx \l_tmpa_tl {\tl_to_str:n {::}}
    \seq_set_split:NVV \l_dhkdiagram_parts_seq \l_tmpa_tl \l_dhkdiagram_left_tl
    \seq_pop_left:NN \l_dhkdiagram_parts_seq \l_dhkdiagram_left_tl
    \tl_trim_spaces:N \l_dhkdiagram_left_tl
    \seq_if_empty:NTF \l_dhkdiagram_parts_seq
     {\tl_clear:N \l_dhkdiagram_right_tl}
     {\seq_pop_left:NN \l_dhkdiagram_parts_seq \l_dhkdiagram_right_tl
      \tl_trim_spaces:N \l_dhkdiagram_right_tl}
    \regex_extract_once:nVNTF
     {\A node \s+ ([A-Za-z_][-A-Za-z0-9_]*) \s* \( \s* ([1-9][0-9]*) \s* , \s* ([1-9][0-9]*) \s* \) \Z}
     \l_dhkdiagram_left_tl \l_dhkdiagram_matches_seq
     {
      \tl_set:Nx \l_dhkdiagram_id_tl {\seq_item:Nn \l_dhkdiagram_matches_seq {2}}
      \int_set:Nn \l_dhkdiagram_row_int {\seq_item:Nn \l_dhkdiagram_matches_seq {3}}
      \int_set:Nn \l_dhkdiagram_col_int {\seq_item:Nn \l_dhkdiagram_matches_seq {4}}
      \prop_if_in:NVTF \l_dhkdiagram_label_prop \l_dhkdiagram_id_tl
       {\PackageWarning{mynotes}{Duplicate~dhkdiagram~node~\tl_use:N\l_dhkdiagram_id_tl}}
       {
        \seq_put_right:NV \l_dhkdiagram_ids_seq \l_dhkdiagram_id_tl
        \prop_put:NVx \l_dhkdiagram_row_prop \l_dhkdiagram_id_tl {\int_use:N \l_dhkdiagram_row_int}
        \prop_put:NVx \l_dhkdiagram_col_prop \l_dhkdiagram_id_tl {\int_use:N \l_dhkdiagram_col_int}
        \prop_put:NVV \l_dhkdiagram_label_prop \l_dhkdiagram_id_tl \l_dhkdiagram_right_tl
        \int_set:Nn \l_dhkdiagram_maxrow_int
         {\int_max:nn {\l_dhkdiagram_maxrow_int}{\l_dhkdiagram_row_int}}
        \int_set:Nn \l_dhkdiagram_maxcol_int
         {\int_max:nn {\l_dhkdiagram_maxcol_int}{\l_dhkdiagram_col_int}}
        \hbox_set:Nn \l_dhkdiagram_measure_box
         {\exp_args:NV \dhkdiagram_print_label:n \l_dhkdiagram_right_tl}
        \tl_set:Nx \l_tmpb_tl {\int_use:N \l_dhkdiagram_col_int}
        \prop_get:NVNTF \l_dhkdiagram_colwidth_prop \l_tmpb_tl \l_tmpa_tl
         {\dim_set:Nn \l_dhkdiagram_size_dim
           {\dim_max:nn {\l_tmpa_tl}{\box_wd:N \l_dhkdiagram_measure_box}}}
         {\dim_set:Nn \l_dhkdiagram_size_dim {\box_wd:N \l_dhkdiagram_measure_box}}
        \prop_put:NVx \l_dhkdiagram_colwidth_prop \l_tmpb_tl
         {\dim_use:N \l_dhkdiagram_size_dim}
        \tl_set:Nx \l_tmpb_tl {\int_use:N \l_dhkdiagram_row_int}
        \prop_get:NVNTF \l_dhkdiagram_rowheight_prop \l_tmpb_tl \l_tmpa_tl
         {\dim_set:Nn \l_dhkdiagram_size_dim
           {\dim_max:nn {\l_tmpa_tl}
            {\box_ht:N\l_dhkdiagram_measure_box + \box_dp:N\l_dhkdiagram_measure_box}}}
         {\dim_set:Nn \l_dhkdiagram_size_dim
           {\box_ht:N\l_dhkdiagram_measure_box + \box_dp:N\l_dhkdiagram_measure_box}}
        \prop_put:NVx \l_dhkdiagram_rowheight_prop \l_tmpb_tl
         {\dim_use:N \l_dhkdiagram_size_dim}
       }
     }
     {
      \regex_match:nVTF {\A (edge|split|merge) \s+} \l_dhkdiagram_left_tl
       {}{\PackageWarning{mynotes}{Ignoring~invalid~dhkdiagram~instruction}}
     }
   }
 }
