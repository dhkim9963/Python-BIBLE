      \regex_replace_once:nnN {\A\|\s*} {} \l_dhkdirx_line_tl
     }{}
    \tl_if_blank:VTF \l_dhkdirx_line_tl
     {\bool_set_true:N \l_dhkdirx_pending_bool}
     {
