% ==================================================
% 8. DHK Branch v15: compact layout + [in=N] + arrowup
% ==================================================
% Syntax (one instruction per line):
%   node   main :: Shell                 (STEP: breaks the spine)
%   line   main :: python train.py ...  (ACTION: text right of spine)
%   arrow  main                         (down arrow)
%   arrowup main                         (up arrow)
%   branchline main -> data :: --data (plain horizontal branch)
%   branch     main -> data :: --data (horizontal arrow)
%   node data :: Path(...)            (STEP in the offshoot)
%   node main :: First line // Second line  (manual line break)
%   node data :: Parent //* child       (small L-shaped child inside node)
%   handoff main -> next :: process()  (end source trunk, continue on next)
% After handoff main -> next, use arrow next / node next (not main).
%   arrow data                         (vertical arrow only on data)
%   stop data                          (ends only data, keeps main)
% No automatic downward arrow is added when branching.
% No LaTeX escaping is needed for ordinary paths and file names.
% v10: horizontal lane spacing 18mm -> 9mm; vertical rows ~2/3 of v9.
%   \begin{dhkbranch}[in=3]    shift complete graph right by 3em.
%   \begin{dhkbranch}[in=5]    shift complete graph right by 5em.
%   \begin{dhkbranch}          default left alignment (no shift).
% Legacy [indent] still supported; uses \dhkbranchindent{7mm} (default 1em).
% 'in=N' accepts nonnegative integer or decimal numbers (e.g. in=4.5).
% For v9's wide spacing, use the saved original v9 section instead.
