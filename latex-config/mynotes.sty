% A connector can require extra space in the gap AFTER its source row.
% Unannotated legacy diagrams never touch this property (3mm stays 3mm).
\cs_new_protected:Npn \dhkdiagram_reserve_gap:nn #1#2
 {
  \tl_set:Nx \l_tmpb_tl {\int_eval:n {#1}}
  \prop_get:NVNTF \l_dhkdiagram_gapafter_prop \l_tmpb_tl \l_tmpa_tl
   {\dim_set:Nn \l_dhkdiagram_requested_gap_dim
     {\dim_max:nn {#2}{\l_tmpa_tl}}}
   {\dim_set:Nn \l_dhkdiagram_requested_gap_dim {#2}}
  \prop_put:NVx \l_dhkdiagram_gapafter_prop \l_tmpb_tl
   {\dim_use:N \l_dhkdiagram_requested_gap_dim}
 }
\cs_new_protected:Npn \dhkdiagram_strip_connector:n #1
 {
  \tl_set:Nn \l_dhkdiagram_left_tl {#1}
  \tl_trim_spaces:N \l_dhkdiagram_left_tl
  \tl_clear:N \l_dhkdiagram_annotation_tl
  \tl_clear:N \l_dhkdiagram_route_tl
  \tl_set:Nx \l_tmpa_tl {\tl_to_str:n {::}}
  \seq_set_split:NVV \l_dhkdiagram_parts_seq \l_tmpa_tl \l_dhkdiagram_left_tl
  \seq_pop_left:NN \l_dhkdiagram_parts_seq \l_dhkdiagram_left_tl
  \tl_trim_spaces:N \l_dhkdiagram_left_tl
  \seq_if_empty:NF \l_dhkdiagram_parts_seq
   {\seq_pop_left:NN \l_dhkdiagram_parts_seq \l_dhkdiagram_route_tl
    \tl_trim_spaces:N \l_dhkdiagram_route_tl}
  % For edges, ':: ROUTE // description', or ':: description'.
  % For split/merge, the entire right side after :: is description.
  \regex_match:nVTF {\A edge \s+} \l_dhkdiagram_left_tl
   {
    \seq_set_split:NnV \l_dhkdiagram_parts_seq {//} \l_dhkdiagram_route_tl
    \seq_pop_left:NN \l_dhkdiagram_parts_seq \l_dhkdiagram_route_tl
    \seq_if_empty:NF \l_dhkdiagram_parts_seq
     {\seq_pop_left:NN \l_dhkdiagram_parts_seq \l_dhkdiagram_annotation_tl}
    \tl_trim_spaces:N \l_dhkdiagram_route_tl
    \tl_trim_spaces:N \l_dhkdiagram_annotation_tl
    \str_case:VnF \l_dhkdiagram_route_tl
     {{HV}{}{VH}{}{straight}{}}
     {\tl_set_eq:NN \l_dhkdiagram_annotation_tl \l_dhkdiagram_route_tl
      \tl_set:Nn \l_dhkdiagram_route_tl {straight}}
    \tl_if_blank:VT \l_dhkdiagram_route_tl
     {\tl_set:Nn \l_dhkdiagram_route_tl {straight}}
   }
   {\tl_set_eq:NN \l_dhkdiagram_annotation_tl \l_dhkdiagram_route_tl}
 }
% Reserve room only when needed for rail geometry or an edge caption.
\cs_new_protected:Npn \dhkdiagram_scan_spacing:n #1
 {
  \dhkdiagram_strip_connector:n {#1}
  \regex_extract_once:nVNTF
    {\A split \s+ ([A-Za-z_][-A-Za-z0-9_]*) \s* -> \s* (.+) \Z}
    \l_dhkdiagram_left_tl \l_dhkdiagram_matches_seq
   {
    \tl_set:Nx \l_dhkdiagram_group_src_tl {\seq_item:Nn \l_dhkdiagram_matches_seq {2}}
    \prop_get:NVNTF \l_dhkdiagram_row_prop \l_dhkdiagram_group_src_tl \l_tmpa_tl
     {\tl_if_blank:VTF \l_dhkdiagram_annotation_tl
       {\dhkdiagram_reserve_gap:nn {\l_tmpa_tl} {9mm}}
       {\dhkdiagram_reserve_gap:nn {\l_tmpa_tl} {14mm}}}{}
   }
   {
    \regex_extract_once:nVNTF
      {\A merge \s+ (.+) \s+ -> \s* ([A-Za-z_][-A-Za-z0-9_]*) \Z}
      \l_dhkdiagram_left_tl \l_dhkdiagram_matches_seq
     {
      \seq_set_split:Nnx \l_dhkdiagram_group_seq {,}
       {\seq_item:Nn \l_dhkdiagram_matches_seq {2}}
      \seq_pop_left:NN \l_dhkdiagram_group_seq \l_dhkdiagram_group_src_tl
      \tl_trim_spaces:N \l_dhkdiagram_group_src_tl
      \prop_get:NVNTF \l_dhkdiagram_row_prop \l_dhkdiagram_group_src_tl \l_tmpa_tl
       {\tl_if_blank:VTF \l_dhkdiagram_annotation_tl
         {\dhkdiagram_reserve_gap:nn {\l_tmpa_tl} {9mm}}
         {\dhkdiagram_reserve_gap:nn {\l_tmpa_tl} {14mm}}}{}
     }
     {
      \tl_if_blank:VF \l_dhkdiagram_annotation_tl
       {
        \regex_extract_once:nVNTF
        {\A edge \s+ ([A-Za-z_][-A-Za-z0-9_]*) \s* (?:<->|->|<-|--) \s* ([A-Za-z_][-A-Za-z0-9_]*) \Z}
        \l_dhkdiagram_left_tl \l_dhkdiagram_matches_seq
        {
         \tl_set:Nx \l_dhkdiagram_group_src_tl {\seq_item:Nn \l_dhkdiagram_matches_seq {2}}
         \tl_set:Nx \l_dhkdiagram_group_dst_tl {\seq_item:Nn \l_dhkdiagram_matches_seq {3}}
         \prop_get:NVNTF \l_dhkdiagram_row_prop \l_dhkdiagram_group_src_tl \l_tmpa_tl
          {\prop_get:NVNTF \l_dhkdiagram_row_prop \l_dhkdiagram_group_dst_tl \l_tmpb_tl
           {\int_compare:nNnF {\l_tmpa_tl} = {\l_tmpb_tl}
             {\dhkdiagram_reserve_gap:nn
                {\int_min:nn {\l_tmpa_tl}{\l_tmpb_tl}} {10mm}}} {}}{}
        }{}
       }
     }
   }
 }

% Grid dimensions use actual maximum node width/height in each col/row.
% All nodes in a column share an x center; all nodes in a row a y center.
\cs_new_protected:Npn \dhkdiagram_positions:
 {
  \dim_zero:N \l_dhkdiagram_cursor_dim
  \int_step_inline:nn {\l_dhkdiagram_maxcol_int}
   {
    \prop_get:NnNTF \l_dhkdiagram_colwidth_prop {##1} \l_tmpa_tl
     {\dim_set:Nn \l_dhkdiagram_size_dim {\l_tmpa_tl}}
     {\dim_zero:N \l_dhkdiagram_size_dim}
    \dim_set:Nn \l_dhkdiagram_coord_dim
     {\l_dhkdiagram_cursor_dim + 0.5\l_dhkdiagram_size_dim}
    \prop_put:Nnx \l_dhkdiagram_x_prop {##1}
     {\dim_use:N \l_dhkdiagram_coord_dim}
    \dim_add:Nn \l_dhkdiagram_cursor_dim
     {\l_dhkdiagram_size_dim + \g_dhkdiagram_hgap_dim}
   }
  \dim_zero:N \l_dhkdiagram_cursor_dim
  \int_step_inline:nn {\l_dhkdiagram_maxrow_int}
   {
    \prop_get:NnNTF \l_dhkdiagram_rowheight_prop {##1} \l_tmpa_tl
     {\dim_set:Nn \l_dhkdiagram_size_dim {\l_tmpa_tl}}
     {\dim_zero:N \l_dhkdiagram_size_dim}
    \dim_set:Nn \l_dhkdiagram_coord_dim
     {-\l_dhkdiagram_cursor_dim - 0.5\l_dhkdiagram_size_dim}
    \prop_put:Nnx \l_dhkdiagram_y_prop {##1}
     {\dim_use:N \l_dhkdiagram_coord_dim}
    \prop_get:NnNTF \l_dhkdiagram_gapafter_prop {##1} \l_tmpb_tl
     {\dim_add:Nn \l_dhkdiagram_cursor_dim
       {\l_dhkdiagram_size_dim + \dim_max:nn {\g_dhkdiagram_vgap_dim}{\l_tmpb_tl}}}
     {\dim_add:Nn \l_dhkdiagram_cursor_dim
       {\l_dhkdiagram_size_dim + \g_dhkdiagram_vgap_dim}}
   }
 }
\cs_new_protected:Npn \dhkdiagram_draw_nodes:
 {
  \seq_map_inline:Nn \l_dhkdiagram_ids_seq
   {
    \tl_set:Nn \l_dhkdiagram_id_tl {##1}
    \prop_get:NVN \l_dhkdiagram_row_prop \l_dhkdiagram_id_tl \l_tmpa_tl
    \prop_get:NVN \l_dhkdiagram_col_prop \l_dhkdiagram_id_tl \l_tmpb_tl
    \prop_get:NVN \l_dhkdiagram_label_prop \l_dhkdiagram_id_tl \l_dhkdiagram_label_tl
    \prop_get:NVN \l_dhkdiagram_x_prop \l_tmpb_tl \l_dhkdiagram_left_tl
    \prop_get:NVN \l_dhkdiagram_y_prop \l_tmpa_tl \l_dhkdiagram_right_tl
    \node[anchor=center,inner~sep=0pt,outer~sep=0pt,fill=white]
     (dhkdiag-\l_dhkdiagram_id_tl)
     at (\l_dhkdiagram_left_tl,\l_dhkdiagram_right_tl)
     {\exp_args:NV \dhkdiagram_print_label:n \l_dhkdiagram_label_tl};
   }
 }
% v3: line notes. Vertical lines place annotation to their right;
% horizontal lines place it above. A note does not replace the line.
\cs_new_protected:Npn \dhkdiagram_styled_draw:n #1
 {
  \tl_if_blank:VTF \l_dhkdiagram_annotation_tl
   {
    \str_case:VnF \l_dhkdiagram_dir_tl
     {{--}{\draw[thin] #1;}
      {<->}{\draw[thin,{Stealth[length=1.6mm]}-{Stealth[length=1.6mm]}] #1;}}
     {\draw[thin,-{Stealth[length=1.6mm]}] #1;}
   }
   {
    \str_if_eq:VnTF \l_dhkdiagram_annotation_pos_tl {above}
      {\dhkdiagram_styled_note:nn {#1} {above}}
      {\dhkdiagram_styled_note:nn {#1} {right}}
   }
 }
\cs_new_protected:Npn \dhkdiagram_styled_note:nn #1#2
 {
  \str_case:VnF \l_dhkdiagram_dir_tl
    {
     {--}{\draw[thin] #1 node[midway,#2=2mm,fill=white,inner~sep=0.5pt,
                      font=\ttfamily\small] {\tl_use:N \l_dhkdiagram_annotation_tl};}
     {<->}{\draw[thin,{Stealth[length=1.6mm]}-{Stealth[length=1.6mm]}]
                   #1 node[midway,#2=2mm,fill=white,inner~sep=0.5pt,
                      font=\ttfamily\small] {\tl_use:N \l_dhkdiagram_annotation_tl};}
    }
    {\draw[thin,-{Stealth[length=1.6mm]}]
                  #1 node[midway,#2=2mm,fill=white,inner~sep=0.5pt,
                      font=\ttfamily\small] {\tl_use:N \l_dhkdiagram_annotation_tl};}
 }
\cs_new_protected:Npn \dhkdiagram_draw_edge:n #1
 {
  \dhkdiagram_strip_connector:n {#1}
  \regex_extract_once:nVNTF
   {\A edge \s+ ([A-Za-z_][-A-Za-z0-9_]*) \s* (<->|->|<-|--) \s* ([A-Za-z_][-A-Za-z0-9_]*) \Z}
   \l_dhkdiagram_left_tl \l_dhkdiagram_matches_seq
   {
    \tl_set:Nx \l_dhkdiagram_src_tl {\seq_item:Nn \l_dhkdiagram_matches_seq {2}}
    \tl_set:Nx \l_dhkdiagram_dir_tl {\seq_item:Nn \l_dhkdiagram_matches_seq {3}}
    \tl_set:Nx \l_dhkdiagram_dst_tl {\seq_item:Nn \l_dhkdiagram_matches_seq {4}}
    \str_if_eq:VnT \l_dhkdiagram_dir_tl {<-}
     {\tl_set_eq:NN \l_tmpa_tl \l_dhkdiagram_src_tl
      \tl_set_eq:NN \l_dhkdiagram_src_tl \l_dhkdiagram_dst_tl
      \tl_set_eq:NN \l_dhkdiagram_dst_tl \l_tmpa_tl}
    \prop_if_in:NVTF \l_dhkdiagram_label_prop \l_dhkdiagram_src_tl
     {
      \prop_if_in:NVTF \l_dhkdiagram_label_prop \l_dhkdiagram_dst_tl
