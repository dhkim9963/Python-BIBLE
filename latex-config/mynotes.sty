    \int_compare:nNnT {##1} > {1} {\par}
    \tl_trim_spaces:n {##2}
   }
 }
\cs_new_protected:Npn \dhkgraph_prepare:
 {
  \seq_clear:N \l_dhkgraph_nodes_seq
  \seq_clear:N \l_dhkgraph_groups_seq
  \seq_clear:N \l_dhkgraph_edges_seq
  \prop_clear:N \l_dhkgraph_rows_prop
  \prop_clear:N \l_dhkgraph_cols_prop
  \prop_clear:N \l_dhkgraph_col_width_prop
  \prop_clear:N \l_dhkgraph_row_height_prop
  \prop_clear:N \l_dhkgraph_col_x_prop
  \prop_clear:N \l_dhkgraph_row_y_prop
  \prop_clear:N \l_dhkgraph_group_members_prop
\prop_clear:N \l_dhkgraph_nested_members_prop
\prop_clear:N \l_dhkgraph_group_depth_prop
\prop_clear:N \l_dhkgraph_node_depth_prop
\prop_clear:N \l_dhkgraph_rendered_ids_prop
\seq_clear:N \l_dhkgraph_pending_groups_seq
\seq_clear:N \l_dhkgraph_next_groups_seq
  \prop_clear:N \l_dhkgraph_node_markers_prop
  \prop_clear:N \l_dhkgraph_group_markers_prop
  \prop_clear:N \l_dhkgraph_group_marker_members_prop
  \bool_set_false:N \l_dhkgraph_explicit_spacing_bool
  \bool_set_false:N \l_dhkgraph_measuring_bool
  \bool_set_false:N \l_dhkgraph_uniform_bool
  \dim_set:Nn \l_dhkgraph_uniform_width_dim {13mm}
  \int_zero:N \l_dhkgraph_max_col_int
  \int_zero:N \l_dhkgraph_max_row_int
  \dim_set:Nn \l_dhkgraph_col_gap_dim {11mm}
  \dim_set:Nn \l_dhkgraph_row_gap_dim {10mm}
  \dim_set:Nn \l_dhkgraph_col_dim {55mm}
  \dim_set:Nn \l_dhkgraph_row_dim {28mm}
  \dim_zero:N \l_dhkgraph_indent_dim
  \tl_clear:N \l_dhkgraph_caption_tl
  \tl_clear:N \l_dhkgraph_explain_tl
  \bool_set_false:N \l_dhkgraph_explain_bool
  \bool_set_false:N \l_dhkgraph_caption_bool
  \int_zero:N \l_dhkgraph_conn_int
  \tl_set_eq:NN \l_dhkgraph_tmp_tl \g_dhkgraph_option_tl
  \tl_trim_spaces:N \l_dhkgraph_tmp_tl
  \regex_match:nVT {\A\s*uniform\s*\Z|\A\s*uniform\s*,|,\s*uniform\s*\Z|,\s*uniform\s*,}
    \l_dhkgraph_tmp_tl
    {\bool_set_true:N \l_dhkgraph_uniform_bool}
  \regex_extract_once:nVNT
   {(?:\A|,)\s*in\s*=\s*([0-9]+(?:\.[0-9]+)?)(?:,|\Z)}
   \l_dhkgraph_tmp_tl \l_dhkgraph_matches_seq
   {\dim_set:Nn \l_dhkgraph_indent_dim
      {\seq_item:Nn \l_dhkgraph_matches_seq {2} em}}
 }
\cs_new_protected:Npn \dhkgraph_read_line:n #1
 {
  \tl_set:Nn \l_dhkgraph_line_tl {#1}
  \tl_trim_spaces:N \l_dhkgraph_line_tl
  \tl_if_blank:VF \l_dhkgraph_line_tl
   {
    \regex_match:nVTF {\A node\s+} \l_dhkgraph_line_tl
     {
      \regex_match:nVTF {\A node\s+size\s*::\s*uniform\s*\Z} \l_dhkgraph_line_tl
       {\bool_set_true:N \l_dhkgraph_uniform_bool}
       {\seq_put_right:NV \l_dhkgraph_nodes_seq \l_dhkgraph_line_tl}
     }
     {
      \regex_match:nVTF {\A group\s+} \l_dhkgraph_line_tl
       {\seq_put_right:NV \l_dhkgraph_groups_seq \l_dhkgraph_line_tl}
       {
        \regex_match:nVTF {\A (edge|split|merge)\s+} \l_dhkgraph_line_tl
         {\seq_put_right:NV \l_dhkgraph_edges_seq \l_dhkgraph_line_tl}
         {
          \regex_extract_once:nVNTF
            {\A caption\s*::\s*(.*)\Z}
             \l_dhkgraph_line_tl \l_dhkgraph_matches_seq
           {\tl_set:Nx \l_dhkgraph_caption_tl
             {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
            \bool_set_true:N \l_dhkgraph_caption_bool}
           {
            \regex_extract_once:nVNTF
             {\A spacing\s*::\s*([0-9.]+mm)\s*,\s*([0-9.]+mm)\Z}
              \l_dhkgraph_line_tl \l_dhkgraph_matches_seq
             {\bool_set_true:N \l_dhkgraph_explicit_spacing_bool
              \dim_set:Nn \l_dhkgraph_col_dim
                 {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
              \dim_set:Nn \l_dhkgraph_row_dim
                 {\seq_item:Nn \l_dhkgraph_matches_seq {3}}}
             {
              \regex_extract_once:nVNTF
               {\A (?:explain|description)\s*::\s*(.*)\Z}
               \l_dhkgraph_line_tl \l_dhkgraph_matches_seq
               {\tl_set:Nx \l_dhkgraph_explain_tl
                 {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
                \bool_set_true:N \l_dhkgraph_explain_bool}
               {\PackageWarning{mynotes}{dhkgraph~unknown~line~\tl_use:N\l_dhkgraph_line_tl}}
             }
           }
         }
       }
     }
   }
 }
% Automatic content width: longest // segment is measured at the actual text font.
% Short labels stay compact; long labels wrap at a readable upper bound.
\cs_new_protected:Npn \dhkgraph_auto_width:n #1
 {
  \dim_zero:N \l_dhkgraph_auto_width_dim
  \seq_set_split:Nnn \l_dhkgraph_width_lines_seq {//} {#1}
  \seq_map_inline:Nn \l_dhkgraph_width_lines_seq
   {
    % Measure natural text extent inside an actual TikZ node: TikZ uses
    % nullfont outside nodes, so measuring in an ordinary \hbox is wrong.
    \node[dhkg-measure,font=\small,inner~sep=0pt,outer~sep=0pt]
       (dhkg-text-measure) at (0,0)
       {\dhkgraph_show_text:n {##1}};
    \pgfextractx{\l_tmpa_dim}
       {\pgfpointanchor{dhkg-text-measure}{east}}
    \pgfextractx{\l_tmpb_dim}
       {\pgfpointanchor{dhkg-text-measure}{west}}
    \dim_set:Nn \l_dhkgraph_auto_width_dim
       {\dim_max:nn {\l_dhkgraph_auto_width_dim}
          {\l_tmpa_dim - \l_tmpb_dim}}
   }
  % Match v1's familiar baseline: compact one-line nodes, roomier
  % multi-line nodes.  Grow until the 57mm wrapping threshold.
  \int_compare:nNnTF {\seq_count:N \l_dhkgraph_width_lines_seq} > {2}
   {\dim_set:Nn \l_dhkgraph_measured_w_dim {43mm}}
   {\int_compare:nNnTF {\seq_count:N \l_dhkgraph_width_lines_seq} > {1}
     {\dim_set:Nn \l_dhkgraph_measured_w_dim {34mm}}
     {\dim_set:Nn \l_dhkgraph_measured_w_dim {13mm}}}
  \dim_set:Nn \l_dhkgraph_auto_width_dim
    {\dim_min:nn {57mm}
       {\dim_max:nn {\l_dhkgraph_measured_w_dim}
          {\l_dhkgraph_auto_width_dim + 3mm}}}
 }
% Uniform mode: // always means an explicit line break.
% Every individual line is measured at its natural width and protected
% from automatic wrapping. All nodes use the widest individual line.
% adjustbox scales the complete diagram to the printable page width.
\cs_new_protected:Npn \dhkgraph_show_uniform_text:n #1
 {
  \seq_set_split:Nnn \l_dhkgraph_width_lines_seq {//} {#1}
  \seq_map_indexed_inline:Nn \l_dhkgraph_width_lines_seq
   {
    \int_compare:nNnT {##1} > {1} {\par}
    \mbox{\dhkgraph_show_text:n {##2}}
   }
 }
\cs_new_protected:Npn \dhkgraph_scan_uniform_width:
 {
  \dim_set:Nn \l_dhkgraph_uniform_width_dim {13mm}
  \seq_map_inline:Nn \l_dhkgraph_nodes_seq
   {
    \regex_extract_once:nnNT {\A (.*?) \s* :: \s* (.*) \Z}
     {##1} \l_dhkgraph_matches_seq
     {
      \tl_set:Nx \l_dhkgraph_label_tl
       {\seq_item:Nn \l_dhkgraph_matches_seq {3}}
      \tl_trim_spaces:N \l_dhkgraph_label_tl
      \seq_set_split:NnV \l_dhkgraph_width_lines_seq {//} \l_dhkgraph_label_tl
      \seq_map_inline:Nn \l_dhkgraph_width_lines_seq
       {
        \node[dhkg-measure,font=\small,inner~sep=0pt,outer~sep=0pt]
         (dhkg-uniform-measure) at (0,0)
         {\mbox{\dhkgraph_show_text:n {####1}}};
        \pgfextractx{\l_tmpa_dim}
         {\pgfpointanchor{dhkg-uniform-measure}{east}}
        \pgfextractx{\l_tmpb_dim}
         {\pgfpointanchor{dhkg-uniform-measure}{west}}
        \dim_set:Nn \l_dhkgraph_uniform_width_dim
         {\dim_max:nn {\l_dhkgraph_uniform_width_dim}
          {\l_tmpa_dim - \l_tmpb_dim + 3mm}}
       }
     }
   }
 }
% v6: optional <1>, <A>, etc. in node/group declarations.
% Strip only the declaration-side marker before applying the v5 grammar.
\cs_new_protected:Npn \dhkgraph_extract_marker:
 {
  \tl_clear:N \l_dhkgraph_marker_tl
  \regex_extract_once:nVNT
    {<\s*([^<>]+?)\s*>} \l_dhkgraph_line_tl \l_dhkgraph_matches_seq
    {
     \tl_set:Nx \l_dhkgraph_marker_tl
       {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
     \tl_trim_spaces:N \l_dhkgraph_marker_tl
     \regex_replace_once:nnN {\s*<[^<>]+>} {} \l_dhkgraph_line_tl
     \tl_trim_spaces:N \l_dhkgraph_line_tl
    }
 }

% v6: Number/symbol at the left of each marked node or group.
\cs_new_protected:Npn \dhkgraph_draw_marker:nn #1#2
 {
  \tl_if_blank:nF {#2}
   {
    \tl_set:Nn \l_dhkgraph_marker_tl {#2}
    \regex_match:nVF {\.\s*\Z} \l_dhkgraph_marker_tl
       {\tl_put_right:Nn \l_dhkgraph_marker_tl {.}}
    \node[font=\bfseries\small,anchor=east,fill=white,
          inner~xsep=.8mm,inner~ysep=.35mm,outer~sep=0pt]
      at ([xshift=-7mm]dhkg-#1.west)
      {\exp_args:NV \dhkgraph_show_text:n \l_dhkgraph_marker_tl};
   }
 }

% v7: scan direct members, register group dependencies and calculate how
% many nested frames each leaf node requires. Existing one-level layouts
% retain the v6 reserve (14mm wide / 25mm tall per grouped node).
\cs_new_protected:Npn \dhkgraph_scan_groups:
 {
  \seq_map_inline:Nn \l_dhkgraph_groups_seq
   {
    \tl_set:Nn \l_dhkgraph_line_tl {##1}
    \dhkgraph_extract_marker:
    \tl_set:Nx \l_dhkgraph_clean_tl {\l_dhkgraph_marker_tl}
    \regex_extract_once:nVNT
     {\A group\s+([A-Za-z_][A-Za-z_0-9-]*)\s*\(([^)]*)\)}
     \l_dhkgraph_line_tl \l_dhkgraph_matches_seq
     {
      \tl_set:Nx \l_dhkgraph_nested_id_tl
       {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
      \tl_set:Nx \l_dhkgraph_nested_members_tl
       {\seq_item:Nn \l_dhkgraph_matches_seq {3}}
      \prop_put:NVV \l_dhkgraph_nested_members_prop
       \l_dhkgraph_nested_id_tl \l_dhkgraph_nested_members_tl
      \prop_put:NVn \l_dhkgraph_group_depth_prop
       \l_dhkgraph_nested_id_tl {1}
      \seq_set_split:NnV \l_dhkgraph_members_seq {,}
       \l_dhkgraph_nested_members_tl
      \seq_map_inline:Nn \l_dhkgraph_members_seq
       {
        \tl_set:Nn \l_tmpa_tl {####1}
        \tl_trim_spaces:N \l_tmpa_tl
        \prop_put:NVn \l_dhkgraph_group_members_prop \l_tmpa_tl {1}
        \tl_if_blank:VF \l_dhkgraph_clean_tl
         {\prop_put:NVn \l_dhkgraph_group_marker_members_prop
          \l_tmpa_tl {1}}
       }
     }
   }
  % Propagate outer-to-inner nesting depth (max ancestor count).
  \int_step_inline:nn {\seq_count:N \l_dhkgraph_groups_seq}
   {
    \prop_map_inline:Nn \l_dhkgraph_nested_members_prop
     {
      \tl_set:Nn \l_dhkgraph_nested_depth_tl
       {\prop_item:Nn \l_dhkgraph_group_depth_prop {####1}}
      \seq_set_split:Nnn \l_dhkgraph_members_seq {,} {####2}
      \seq_map_inline:Nn \l_dhkgraph_members_seq
       {
        \tl_set:Nn \l_tmpa_tl {########1}
        \tl_trim_spaces:N \l_tmpa_tl
        \prop_if_in:NVT \l_dhkgraph_nested_members_prop \l_tmpa_tl
         {
          \prop_get:NVN \l_dhkgraph_group_depth_prop
            \l_tmpa_tl \l_tmpb_tl
          \int_compare:nNnT
           {\l_dhkgraph_nested_depth_tl + 1} > {\l_tmpb_tl}
           {\prop_put:NVx \l_dhkgraph_group_depth_prop
             \l_tmpa_tl
             {\int_eval:n {\l_dhkgraph_nested_depth_tl + 1}}}
         }
       }
     }
   }
  % Convert group depths into per-node reserves.
  \prop_map_inline:Nn \l_dhkgraph_nested_members_prop
   {
    \tl_set:Nn \l_dhkgraph_nested_depth_tl
     {\prop_item:Nn \l_dhkgraph_group_depth_prop {##1}}
    \seq_set_split:Nnn \l_dhkgraph_members_seq {,} {##2}
    \seq_map_inline:Nn \l_dhkgraph_members_seq
     {
      \tl_set:Nn \l_tmpa_tl {####1}
      \tl_trim_spaces:N \l_tmpa_tl
      \prop_if_in:NVF \l_dhkgraph_nested_members_prop \l_tmpa_tl
       {
        \prop_get:NVNTF \l_dhkgraph_node_depth_prop \l_tmpa_tl
         \l_tmpb_tl
         {
          \int_compare:nNnT {\l_dhkgraph_nested_depth_tl} > {\l_tmpb_tl}
           {\prop_put:NVV \l_dhkgraph_node_depth_prop
             \l_tmpa_tl \l_dhkgraph_nested_depth_tl}
         }
         {\prop_put:NVV \l_dhkgraph_node_depth_prop
           \l_tmpa_tl \l_dhkgraph_nested_depth_tl}
       }
     }
   }
 }

\cs_new_protected:Npn \dhkgraph_update_max:Nnn #1#2#3
 {
  \prop_get:NnNTF #1 {#2} \l_tmpa_tl
    {\dim_compare:nNnT {#3} > {\l_tmpa_tl}
      {\prop_put:Nnx #1 {#2} {\dim_eval:n {#3}}}}
    {\prop_put:Nnx #1 {#2} {\dim_eval:n {#3}}}
 }
% Convert measured per-column widths and row heights into grid centers.
\cs_new_protected:Npn \dhkgraph_build_grid:
 {
  \dim_zero:N \l_dhkgraph_last_dim
  \dim_zero:N \l_dhkgraph_x_dim
  \int_step_inline:nn {\l_dhkgraph_max_col_int}
   {
    \prop_get:NnNTF \l_dhkgraph_col_width_prop {##1} \l_tmpa_tl
      {\dim_set:Nn \l_dhkgraph_current_dim {\l_tmpa_tl}}
      {\dim_set:Nn \l_dhkgraph_current_dim {15mm}}
    \int_compare:nNnT {##1} > {1}
     {
      \dim_set:Nn \l_dhkgraph_next_dim
        {(\l_dhkgraph_last_dim + \l_dhkgraph_current_dim)/2
           + \l_dhkgraph_col_gap_dim}
      \bool_if:NT \l_dhkgraph_explicit_spacing_bool
       {\dim_set:Nn \l_dhkgraph_next_dim
         {\dim_max:nn {\l_dhkgraph_next_dim}{\l_dhkgraph_col_dim}}}
      \dim_add:Nn \l_dhkgraph_x_dim {\l_dhkgraph_next_dim}
     }
    \prop_put:Nnx \l_dhkgraph_col_x_prop {##1}
      {\dim_use:N \l_dhkgraph_x_dim}
    \dim_set:Nn \l_dhkgraph_last_dim {\l_dhkgraph_current_dim}
   }
  \dim_zero:N \l_dhkgraph_last_dim
  \dim_zero:N \l_dhkgraph_y_dim
  \int_step_inline:nn {\l_dhkgraph_max_row_int}
   {
    \prop_get:NnNTF \l_dhkgraph_row_height_prop {##1} \l_tmpa_tl
      {\dim_set:Nn \l_dhkgraph_current_dim {\l_tmpa_tl}}
      {\dim_set:Nn \l_dhkgraph_current_dim {10mm}}
    \int_compare:nNnT {##1} > {1}
     {
      \dim_set:Nn \l_dhkgraph_next_dim
        {(\l_dhkgraph_last_dim + \l_dhkgraph_current_dim)/2
           + \l_dhkgraph_row_gap_dim}
      \bool_if:NT \l_dhkgraph_explicit_spacing_bool
       {\dim_set:Nn \l_dhkgraph_next_dim
         {\dim_max:nn {\l_dhkgraph_next_dim}{\l_dhkgraph_row_dim}}}
      \dim_sub:Nn \l_dhkgraph_y_dim {\l_dhkgraph_next_dim}
     }
    \prop_put:Nnx \l_dhkgraph_row_y_prop {##1}
      {\dim_use:N \l_dhkgraph_y_dim}
    \dim_set:Nn \l_dhkgraph_last_dim {\l_dhkgraph_current_dim}
   }
 }
\cs_new_protected:Npn \dhkgraph_style:n #1
 {
  \tl_set:Nn \l_dhkgraph_style_tl {#1}
  \tl_set:Nn \l_dhkgraph_frame_tl {dhkgraphgray}
  \tl_set:Nn \l_dhkgraph_bg_tl {black!1.5}
  \tl_set:Nn \l_dhkgraph_shape_tl {rectangle}
  \tl_clear:N \l_dhkgraph_width_tl
  \regex_match:nVT {accent} \l_dhkgraph_style_tl
   {\tl_set:Nn \l_dhkgraph_frame_tl {dhkgraphteal}
    \tl_set:Nn \l_dhkgraph_bg_tl {dhkgraphteal!5}}
  \regex_match:nVT {circle} \l_dhkgraph_style_tl
   {\tl_set:Nn \l_dhkgraph_shape_tl {circle}}
  \regex_extract_once:nVNT
   {w\s*=\s*([0-9]+(?:\.[0-9]+)?mm)}
    \l_dhkgraph_style_tl \l_dhkgraph_matches_seq
   {\tl_set:Nx \l_dhkgraph_width_tl
      {\seq_item:Nn \l_dhkgraph_matches_seq {2}}}
 }
\cs_new_protected:Npn \dhkgraph_draw_node:n #1
 {
  \regex_extract_once:nnNTF {\A (.*?) \s* :: \s* (.*) \Z}
    {#1} \l_dhkgraph_matches_seq
   {\tl_set:Nx \l_dhkgraph_line_tl {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
    \tl_set:Nx \l_dhkgraph_label_tl {\seq_item:Nn \l_dhkgraph_matches_seq {3}}}
   {\tl_set:Nn \l_dhkgraph_line_tl {#1} \tl_clear:N \l_dhkgraph_label_tl}
  \tl_trim_spaces:N \l_dhkgraph_line_tl
  \tl_trim_spaces:N \l_dhkgraph_label_tl
  \dhkgraph_extract_marker:
  \regex_extract_once:nVNTF
   {\A node\s+([A-Za-z_][A-Za-z_0-9-]*)\s*\(\s*([0-9]+)\s*,\s*([0-9]+)\s*\)\s*(?:\[(.*)\])?\s*\Z}
    \l_dhkgraph_line_tl \l_dhkgraph_matches_seq
   {
    \tl_set:Nx \l_dhkgraph_id_tl {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
    \tl_if_blank:VF \l_dhkgraph_marker_tl
      {\prop_put:NVV \l_dhkgraph_node_markers_prop
        \l_dhkgraph_id_tl \l_dhkgraph_marker_tl}
    \prop_put:NVx \l_dhkgraph_rows_prop \l_dhkgraph_id_tl
      {\seq_item:Nn \l_dhkgraph_matches_seq {3}}
    \prop_put:NVx \l_dhkgraph_cols_prop \l_dhkgraph_id_tl
      {\seq_item:Nn \l_dhkgraph_matches_seq {4}}
    \exp_args:Ne \dhkgraph_style:n {\seq_item:Nn \l_dhkgraph_matches_seq {5}}
    \bool_if:NTF \l_dhkgraph_uniform_bool
     {\tl_set:Nx \l_dhkgraph_width_tl
       {\dim_use:N \l_dhkgraph_uniform_width_dim}}
     {\tl_if_blank:VT \l_dhkgraph_width_tl
       {\exp_args:NV \dhkgraph_auto_width:n \l_dhkgraph_label_tl
        \tl_set:Nx \l_dhkgraph_width_tl
         {\dim_use:N \l_dhkgraph_auto_width_dim}}}
    \int_set:Nn \l_dhkgraph_max_row_int
      {\int_max:nn {\l_dhkgraph_max_row_int}
        {\prop_item:NV \l_dhkgraph_rows_prop \l_dhkgraph_id_tl}}
    \int_set:Nn \l_dhkgraph_max_col_int
      {\int_max:nn {\l_dhkgraph_max_col_int}
        {\prop_item:NV \l_dhkgraph_cols_prop \l_dhkgraph_id_tl}}
    \prop_get:NVN \l_dhkgraph_rows_prop \l_dhkgraph_id_tl \l_tmpa_tl
    \prop_get:NVN \l_dhkgraph_cols_prop \l_dhkgraph_id_tl \l_tmpb_tl
    \bool_if:NTF \l_dhkgraph_measuring_bool
     {\dim_zero:N \l_dhkgraph_x_dim
      \dim_zero:N \l_dhkgraph_y_dim
      \tl_set:Nx \l_dhkgraph_tmp_tl
        {dhkg-measure-\l_dhkgraph_id_tl}
      \tl_set:Nn \l_dhkgraph_measure_style_tl {dhkg-measure}}
     {\prop_get:NVN \l_dhkgraph_col_x_prop \l_tmpb_tl \l_tmpc_tl
      \dim_set:Nn \l_dhkgraph_x_dim {\l_tmpc_tl}
      \prop_get:NVN \l_dhkgraph_row_y_prop \l_tmpa_tl \l_tmpc_tl
      \dim_set:Nn \l_dhkgraph_y_dim {\l_tmpc_tl}
      \tl_set:Nx \l_dhkgraph_tmp_tl
        {dhkg-\l_dhkgraph_id_tl}
      \tl_set:Nn \l_dhkgraph_measure_style_tl {dhkg-normal}}
    \node[\l_dhkgraph_measure_style_tl,draw=\l_dhkgraph_frame_tl,
      fill=\l_dhkgraph_bg_tl,thick,
      shape=\l_dhkgraph_shape_tl,
      rounded~corners=2.7mm,align=center,
      text~width=\l_dhkgraph_width_tl,
      font=\small,inner~xsep=3mm,inner~ysep=3mm]
      (\l_dhkgraph_tmp_tl)
      at (\l_dhkgraph_x_dim,\l_dhkgraph_y_dim)
      {\bool_if:NTF \l_dhkgraph_uniform_bool
        {\exp_args:NV \dhkgraph_show_uniform_text:n \l_dhkgraph_label_tl}
        {\exp_args:NV \dhkgraph_show_text:n \l_dhkgraph_label_tl}};
    \bool_if:NT \l_dhkgraph_measuring_bool
     {
      \pgfextractx{\l_tmpa_dim}
        {\pgfpointanchor{\l_dhkgraph_tmp_tl}{east}}
      \pgfextractx{\l_tmpb_dim}
        {\pgfpointanchor{\l_dhkgraph_tmp_tl}{west}}
      \dim_set:Nn \l_dhkgraph_measured_w_dim
        {\l_tmpa_dim - \l_tmpb_dim}
      \pgfextracty{\l_tmpa_dim}
        {\pgfpointanchor{\l_dhkgraph_tmp_tl}{north}}
      \pgfextracty{\l_tmpb_dim}
        {\pgfpointanchor{\l_dhkgraph_tmp_tl}{south}}
      \dim_set:Nn \l_dhkgraph_measured_h_dim
        {\l_tmpa_dim - \l_tmpb_dim}
      \prop_if_in:NVT \l_dhkgraph_group_members_prop
           \l_dhkgraph_id_tl
       {\dim_add:Nn \l_dhkgraph_measured_w_dim {14mm}
        \dim_add:Nn \l_dhkgraph_measured_h_dim {25mm}}
      % Nested frames need clearance beyond the original one-level group.
     \prop_get:NVNT \l_dhkgraph_node_depth_prop
      \l_dhkgraph_id_tl \l_tmpc_tl
      {
       \int_compare:nNnT {\l_tmpc_tl} > {1}
        {
         \prg_replicate:nn {\int_eval:n {\l_tmpc_tl - 1}}
          {
           \dim_add:Nn \l_dhkgraph_measured_w_dim {14mm}
           \dim_add:Nn \l_dhkgraph_measured_h_dim {25mm}
          }
        }
      }

      % Only labeled boxes allocate extra width; v5 unlabeled layout unchanged.
      \prop_if_in:NVT \l_dhkgraph_node_markers_prop \l_dhkgraph_id_tl
        {\dim_add:Nn \l_dhkgraph_measured_w_dim {16mm}}
      \prop_if_in:NVT \l_dhkgraph_group_marker_members_prop \l_dhkgraph_id_tl
        {\dim_add:Nn \l_dhkgraph_measured_w_dim {16mm}}
      \prop_get:NVN \l_dhkgraph_cols_prop \l_dhkgraph_id_tl \l_tmpc_tl
      \exp_args:NNV \dhkgraph_update_max:Nnn
        \l_dhkgraph_col_width_prop \l_tmpc_tl
        {\l_dhkgraph_measured_w_dim}
      \prop_get:NVN \l_dhkgraph_rows_prop \l_dhkgraph_id_tl \l_tmpc_tl
      \exp_args:NNV \dhkgraph_update_max:Nnn
        \l_dhkgraph_row_height_prop \l_tmpc_tl
        {\l_dhkgraph_measured_h_dim}
     }
   }
   {\PackageWarning{mynotes}{dhkgraph~bad~node~declaration}}
 }
\cs_new_protected:Npn \dhkgraph_draw_group:n #1
 {
  \regex_extract_once:nnNTF {\A (.*?) \s* :: \s* (.*) \Z}
    {#1} \l_dhkgraph_matches_seq
   {\tl_set:Nx \l_dhkgraph_line_tl {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
    \tl_set:Nx \l_dhkgraph_label_tl {\seq_item:Nn \l_dhkgraph_matches_seq {3}}}
   {\tl_set:Nn \l_dhkgraph_line_tl {#1} \tl_clear:N \l_dhkgraph_label_tl}
  \tl_trim_spaces:N \l_dhkgraph_line_tl
  \tl_trim_spaces:N \l_dhkgraph_label_tl
  \dhkgraph_extract_marker:
  \regex_extract_once:nVNTF
   {\A group\s+([A-Za-z_][A-Za-z_0-9-]*)\s*\(([^)]*)\)\s*(?:\[(.*)\])?\s*\Z}
    \l_dhkgraph_line_tl \l_dhkgraph_matches_seq
   {
    \tl_set:Nx \l_dhkgraph_id_tl {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
    \tl_if_blank:VF \l_dhkgraph_marker_tl
      {\prop_put:NVV \l_dhkgraph_group_markers_prop
        \l_dhkgraph_id_tl \l_dhkgraph_marker_tl}
    \tl_set:Nx \l_dhkgraph_tmp_tl {\seq_item:Nn \l_dhkgraph_matches_seq {3}}
    \exp_args:Ne \dhkgraph_style:n {\seq_item:Nn \l_dhkgraph_matches_seq {4}}
    \seq_set_split:NnV \l_dhkgraph_members_seq {,} \l_dhkgraph_tmp_tl
    \tl_clear:N \l_dhkgraph_fit_tl
   \tl_set_eq:NN \l_dhkgraph_group_bg_tl \l_dhkgraph_bg_tl
    \seq_map_inline:Nn \l_dhkgraph_members_seq
     {\tl_set:Nn \l_tmpa_tl {##1}
      \tl_trim_spaces:N \l_tmpa_tl
     \prop_if_in:NVT \l_dhkgraph_nested_members_prop \l_tmpa_tl
       {\tl_set:Nn \l_dhkgraph_group_bg_tl {none}}
      \tl_put_right:Nx \l_dhkgraph_fit_tl
        {(dhkg-\l_tmpa_tl)}}
    \begin{scope}[on~background~layer]
    \node[\l_dhkgraph_measure_style_tl,draw=\l_dhkgraph_frame_tl,fill=\l_dhkgraph_group_bg_tl,
      thick,rounded~corners=3mm,
      fit=\l_dhkgraph_fit_tl,inner~xsep=6mm,inner~ysep=12mm]
      (dhkg-\l_dhkgraph_id_tl) {};
    \end{scope}
    \node[anchor=north,align=center,font=\bfseries\small,
       inner~sep=0pt,yshift=-2.5mm]
      at (dhkg-\l_dhkgraph_id_tl.north)
      {\exp_args:NV \dhkgraph_show_text:n \l_dhkgraph_label_tl};
   }
   {\PackageWarning{mynotes}{dhkgraph~bad~group~declaration}}
 }
% ---- v5: optional connector labels, without changing existing paths ----
\cs_generate_variant:Nn \regex_split:nnN {nVN}
\tl_new:N \l_dhkgraph_edge_source_tl
\tl_new:N \l_dhkgraph_edge_target_tl
\tl_new:N \l_dhkgraph_conn_label_tl
\tl_new:N \l_dhkgraph_common_label_tl
\tl_new:N \l_dhkgraph_clean_tl
\tl_new:N \l_dhkgraph_side_tl
\tl_new:N \l_dhkgraph_target_tl
\seq_new:N \l_dhkgraph_targets_seq
\seq_new:N \l_dhkgraph_labels_seq
\seq_new:N \l_dhkgraph_segments_seq
\bool_new:N \l_dhkgraph_any_branch_label_bool

% Tiny white-backed label; appended after lines. Node/edge coordinates are unchanged,
% and the label is included in the picture width for adjustbox scaling.
\cs_new_protected:Npn \dhkgraph_path_label:n #1
 {
  \tl_if_blank:VF \l_dhkgraph_conn_label_tl
   {
    node[midway,#1,font=\scriptsize,text=black!70,
         fill=white,inner~sep=.7mm,outer~sep=0pt]
      {\exp_args:NV \dhkgraph_show_text:n \l_dhkgraph_conn_label_tl}
   }
 }

% Label an edge along the same anchors as the existing edge function.
% Vertical: right of line; horizontal: above line; diagonal: right.
\cs_new_protected:Npn \dhkgraph_label_edge:nn #1#2
 {
  \tl_if_blank:VF \l_dhkgraph_conn_label_tl
   {
    \prop_get:NnNTF \l_dhkgraph_rows_prop {#1} \l_tmpa_tl
     {
      \prop_get:NnNTF \l_dhkgraph_rows_prop {#2} \l_tmpb_tl
       {
        \prop_get:NnN \l_dhkgraph_cols_prop {#1} \l_dhkgraph_a_tl
        \prop_get:NnN \l_dhkgraph_cols_prop {#2} \l_dhkgraph_b_tl
        \int_compare:nNnTF {\l_tmpa_tl} = {\l_tmpb_tl}
         {
          \int_compare:nNnTF {\l_dhkgraph_a_tl} < {\l_dhkgraph_b_tl}
           {\path (dhkg-#1.east) -- (dhkg-#2.west)
                \dhkgraph_path_label:n {above=1mm};}
           {\path (dhkg-#1.west) -- (dhkg-#2.east)
                \dhkgraph_path_label:n {above=1mm};}
         }
         {
          \int_compare:nNnTF {\l_dhkgraph_a_tl} = {\l_dhkgraph_b_tl}
           {
            \int_compare:nNnTF {\l_tmpa_tl} < {\l_tmpb_tl}
             {\path (dhkg-#1.south)--(dhkg-#2.north)
                \dhkgraph_path_label:n {right=1.5mm};}
             {\path (dhkg-#1.north)--(dhkg-#2.south)
                \dhkgraph_path_label:n {right=1.5mm};}
           }
           {\path (dhkg-#1)--(dhkg-#2)
                \dhkgraph_path_label:n {right=1.5mm};}
         }
       }
       {\path (dhkg-#1)--(dhkg-#2)
          \dhkgraph_path_label:n {right=1.5mm};}
     }
     {\path (dhkg-#1)--(dhkg-#2)
        \dhkgraph_path_label:n {right=1.5mm};}
   }
 }

% Parse an individual split/merge member, e.g. a :: 설명.
% Store the target and label in parallel sequences.
\cs_new_protected:Npn \dhkgraph_parse_member:n #1
 {
  \regex_split:nnN {::} {#1} \l_dhkgraph_segments_seq
  \tl_set:Nx \l_dhkgraph_target_tl
   {\seq_item:Nn \l_dhkgraph_segments_seq {1}}
  \tl_trim_spaces:N \l_dhkgraph_target_tl
  \tl_clear:N \l_dhkgraph_conn_label_tl
  \int_compare:nNnT {\seq_count:N \l_dhkgraph_segments_seq} > {1}
   {
    \tl_set:Nx \l_dhkgraph_conn_label_tl
     {\seq_item:Nn \l_dhkgraph_segments_seq {2}}
    \tl_trim_spaces:N \l_dhkgraph_conn_label_tl
    \bool_set_true:N \l_dhkgraph_any_branch_label_bool
   }
  \seq_put_right:NV \l_dhkgraph_targets_seq \l_dhkgraph_target_tl
  \seq_put_right:NV \l_dhkgraph_labels_seq \l_dhkgraph_conn_label_tl
 }

% Draw labels on existing split/merge vertical legs; labels never move
% or redraw the original rail. For 3+ branches, leftmost label goes left.
\cs_new_protected:Npn \dhkgraph_label_rail_members:n #1
 {
  \int_step_inline:nn {\seq_count:N \l_dhkgraph_targets_seq}
   {
    \tl_set:Nx \l_dhkgraph_target_tl
     {\seq_item:Nn \l_dhkgraph_targets_seq {##1}}
    \tl_set:Nx \l_dhkgraph_conn_label_tl
     {\seq_item:Nn \l_dhkgraph_labels_seq {##1}}
    \tl_set:Nn \l_dhkgraph_side_tl {right=1.5mm}
    \int_compare:nNnT {\seq_count:N \l_dhkgraph_targets_seq} > {2}
     {
      \int_compare:nNnT {##1} = {1}
       {\tl_set:Nn \l_dhkgraph_side_tl {left=1.5mm}}
     }
    \str_if_eq:nnTF {#1} {split}
     {
      \path (dhkg-\l_dhkgraph_target_tl.north |- dhkg-rail-\int_use:N\l_dhkgraph_conn_int)
          -- (dhkg-\l_dhkgraph_target_tl.north)
          \exp_args:NV \dhkgraph_path_label:n \l_dhkgraph_side_tl ;
     }
     {
      \path (dhkg-\l_dhkgraph_target_tl.south)
          -- (dhkg-\l_dhkgraph_target_tl.south |- dhkg-rail-\int_use:N\l_dhkgraph_conn_int)
          \exp_args:NV \dhkgraph_path_label:n \l_dhkgraph_side_tl ;
     }
   }
 }

% `split root -> a,b,c :: 공통` puts one label on the stem.
% `split root -> a :: A,b :: B,c :: C` labels each branch.
% Merge has symmetrical syntax.
\cs_new_protected:Npn \dhkgraph_labeled_shared:n #1
 {
  \seq_clear:N \l_dhkgraph_targets_seq
  \seq_clear:N \l_dhkgraph_labels_seq
  \bool_set_false:N \l_dhkgraph_any_branch_label_bool
  \tl_clear:N \l_dhkgraph_common_label_tl
  \regex_match:nnTF {\A\s*split\s+} {#1}
   {
    \regex_extract_once:nnNTF
     {\A\s*split\s+([A-Za-z_][A-Za-z_0-9-]*)\s*->\s*(.+)\Z}
     {#1} \l_dhkgraph_matches_seq
     {
      \tl_set:Nx \l_dhkgraph_id_tl
       {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
      \tl_set:Nx \l_dhkgraph_tmp_tl
       {\seq_item:Nn \l_dhkgraph_matches_seq {3}}
      \seq_set_split:NnV \l_dhkgraph_members_seq {,} \l_dhkgraph_tmp_tl
      \seq_map_inline:Nn \l_dhkgraph_members_seq
       {\dhkgraph_parse_member:n {##1}}
      % Last-only label with multiple branches is the common-stem label.
      \int_compare:nNnT {\seq_count:N \l_dhkgraph_targets_seq} > {1}
       {
        \bool_set_false:N \l_tmpa_bool
        \int_step_inline:nn
         {\int_eval:n {\seq_count:N \l_dhkgraph_targets_seq - 1}}
         {
          \tl_set:Nx \l_tmpa_tl
           {\seq_item:Nn \l_dhkgraph_labels_seq {##1}}
          \tl_if_blank:VF \l_tmpa_tl {\bool_set_true:N \l_tmpa_bool}
         }
        \bool_if:NF \l_tmpa_bool
         {
          \tl_set:Nx \l_dhkgraph_common_label_tl
           {\seq_item:Nn \l_dhkgraph_labels_seq {-1}}
          \seq_pop_right:NN \l_dhkgraph_labels_seq \l_tmpa_tl
          \seq_put_right:Nn \l_dhkgraph_labels_seq {}
         }
       }
      \tl_set:Nx \l_dhkgraph_line_tl
       {split~\l_dhkgraph_id_tl~->~\seq_use:Nn \l_dhkgraph_targets_seq {,~}}
      \dhkgraph_shared_rail:n {split}
      \dhkgraph_label_rail_members:n {split}
      \tl_set_eq:NN \l_dhkgraph_conn_label_tl \l_dhkgraph_common_label_tl
      \path (dhkg-\l_dhkgraph_id_tl.south)
        -- (dhkg-\l_dhkgraph_id_tl.south |- dhkg-rail-\int_use:N\l_dhkgraph_conn_int)
        \dhkgraph_path_label:n {right=1.5mm};
     }
     {\PackageWarning{mynotes}{dhkgraph~bad~labeled~split}}
   }
   {
    \seq_set_split:Nnn \l_dhkgraph_parts_seq {->} {#1}
    \int_compare:nNnTF {\seq_count:N \l_dhkgraph_parts_seq} = {2}
     {
      \tl_set:Nx \l_dhkgraph_tmp_tl
       {\seq_item:Nn \l_dhkgraph_parts_seq {1}}
      \regex_replace_once:nnN {\A\s*merge\s+} {} \l_dhkgraph_tmp_tl
      \seq_set_split:NnV \l_dhkgraph_members_seq {,} \l_dhkgraph_tmp_tl
      \seq_map_inline:Nn \l_dhkgraph_members_seq
       {\dhkgraph_parse_member:n {##1}}
      \tl_set:Nx \l_dhkgraph_tmp_tl
       {\seq_item:Nn \l_dhkgraph_parts_seq {2}}
      \regex_split:nVN {::} \l_dhkgraph_tmp_tl \l_dhkgraph_segments_seq
      \tl_set:Nx \l_dhkgraph_id_tl
       {\seq_item:Nn \l_dhkgraph_segments_seq {1}}
      \tl_trim_spaces:N \l_dhkgraph_id_tl
      \int_compare:nNnT {\seq_count:N \l_dhkgraph_segments_seq} > {1}
       {
        \tl_set:Nx \l_dhkgraph_common_label_tl
         {\seq_item:Nn \l_dhkgraph_segments_seq {2}}
        \tl_trim_spaces:N \l_dhkgraph_common_label_tl
       }
      \tl_set:Nx \l_dhkgraph_line_tl
       {merge~\seq_use:Nn \l_dhkgraph_targets_seq {,~}~->~\l_dhkgraph_id_tl}
      \dhkgraph_shared_rail:n {merge}
      \dhkgraph_label_rail_members:n {merge}
      \tl_set_eq:NN \l_dhkgraph_conn_label_tl \l_dhkgraph_common_label_tl
      \path (dhkg-\l_dhkgraph_id_tl.north |- dhkg-rail-\int_use:N\l_dhkgraph_conn_int)
        -- (dhkg-\l_dhkgraph_id_tl.north)
        \dhkgraph_path_label:n {right=1.5mm};
     }
     {\PackageWarning{mynotes}{dhkgraph~bad~labeled~merge}}
   }
 }

\cs_new_protected:Npn \dhkgraph_draw_edge:nnn #1#2#3
 {
  \prop_get:NnNTF \l_dhkgraph_rows_prop {#1} \l_tmpa_tl
   {\prop_get:NnNTF \l_dhkgraph_rows_prop {#3} \l_tmpb_tl
    {\prop_get:NnN \l_dhkgraph_cols_prop {#1} \l_dhkgraph_a_tl
     \prop_get:NnN \l_dhkgraph_cols_prop {#3} \l_dhkgraph_b_tl
     \int_compare:nNnTF {\l_tmpa_tl} = {\l_tmpb_tl}
       {\int_compare:nNnTF {\l_dhkgraph_a_tl} < {\l_dhkgraph_b_tl}
        {\draw[#2] (dhkg-#1.east)--(dhkg-#3.west);}
        {\draw[#2] (dhkg-#1.west)--(dhkg-#3.east);}}
       {\int_compare:nNnTF {\l_dhkgraph_a_tl} = {\l_dhkgraph_b_tl}
        {\int_compare:nNnTF {\l_tmpa_tl} < {\l_tmpb_tl}
         {\draw[#2] (dhkg-#1.south)--(dhkg-#3.north);}
         {\draw[#2] (dhkg-#1.north)--(dhkg-#3.south);}}
        {\draw[#2] (dhkg-#1)--(dhkg-#3);}}}
    {\draw[#2] (dhkg-#1)--(dhkg-#3);}}
   {\draw[#2] (dhkg-#1)--(dhkg-#3);}
 }
\cs_new_protected:Npn \dhkgraph_draw_connector:n #1
 {
  \regex_split:nnN {::} {#1} \l_dhkgraph_parts_seq
  \tl_set:Nx \l_dhkgraph_line_tl {\seq_item:Nn \l_dhkgraph_parts_seq {1}}
  \tl_trim_spaces:N \l_dhkgraph_line_tl
  \tl_clear:N \l_dhkgraph_conn_label_tl
  \int_compare:nNnT {\seq_count:N \l_dhkgraph_parts_seq} > {1}
   {
    \tl_set:Nx \l_dhkgraph_conn_label_tl
     {\seq_item:Nn \l_dhkgraph_parts_seq {2}}
    \tl_trim_spaces:N \l_dhkgraph_conn_label_tl
   }
  \regex_extract_once:nVNTF
   {\A edge\s+([A-Za-z_][A-Za-z_0-9-]*)\s*(<->|->|<-|--)\s*([A-Za-z_][A-Za-z_0-9-]*)\Z}
   \l_dhkgraph_line_tl \l_dhkgraph_matches_seq
   {
    \tl_set:Nx \l_dhkgraph_a_tl {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
    \tl_set:Nx \l_dhkgraph_direction_tl {\seq_item:Nn \l_dhkgraph_matches_seq {3}}
    \tl_set:Nx \l_dhkgraph_b_tl {\seq_item:Nn \l_dhkgraph_matches_seq {4}}
    \tl_set:Nx \l_dhkgraph_edge_source_tl {\l_dhkgraph_a_tl}
    \tl_set:Nx \l_dhkgraph_edge_target_tl {\l_dhkgraph_b_tl}
    \str_case:VnF \l_dhkgraph_direction_tl
     {
      {->} {\exp_args:NVV \dhkgraph_forward:nn \l_dhkgraph_a_tl \l_dhkgraph_b_tl}
      {<-} {\exp_args:NVV \dhkgraph_forward:nn \l_dhkgraph_b_tl \l_dhkgraph_a_tl}
      {<->} {\exp_args:NVV \dhkgraph_both:nn \l_dhkgraph_a_tl \l_dhkgraph_b_tl}
      {--} {\exp_args:NVV \dhkgraph_plain:nn \l_dhkgraph_a_tl \l_dhkgraph_b_tl}
     }{}
    \exp_args:NVV \dhkgraph_label_edge:nn \l_dhkgraph_edge_source_tl \l_dhkgraph_edge_target_tl
   }
   {
    \regex_match:nVTF {\A (split|merge)\s+} \l_dhkgraph_line_tl
     {\dhkgraph_labeled_shared:n {#1}}
     {\PackageWarning{mynotes}{dhkgraph~bad~connector~declaration}}
   }
 }

\cs_new_protected:Npn \dhkgraph_forward:nn #1#2
 {\dhkgraph_draw_edge:nnn {#1} {line~width=.7pt,-{Stealth[length=2.3mm]}} {#2}}
\cs_new_protected:Npn \dhkgraph_plain:nn #1#2
 {\dhkgraph_draw_edge:nnn {#1} {line~width=.7pt} {#2}}
\cs_new_protected:Npn \dhkgraph_both:nn #1#2
 {\dhkgraph_draw_edge:nnn {#1} {line~width=.7pt,{Stealth[length=2.3mm]}-{Stealth[length=2.3mm]}} {#2}}
% Shared spine split/merge.  Children should be on a common row.
\cs_new_protected:Npn \dhkgraph_shared_rail:n #1
 {
  \regex_extract_once:nVNTF
   {\A split\s+([A-Za-z_][A-Za-z_0-9-]*)\s*->\s*(.+)\Z}
    \l_dhkgraph_line_tl \l_dhkgraph_matches_seq
   {\tl_set:Nx \l_dhkgraph_id_tl {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
    \tl_set:Nx \l_dhkgraph_tmp_tl {\seq_item:Nn \l_dhkgraph_matches_seq {3}}
    \tl_set:Nn \l_dhkgraph_direction_tl {split}}
   {
    \regex_extract_once:nVNTF
     {\A merge\s+(.+)\s+->\s*([A-Za-z_][A-Za-z_0-9-]*)\Z}
      \l_dhkgraph_line_tl \l_dhkgraph_matches_seq
     {\tl_set:Nx \l_dhkgraph_tmp_tl {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
      \tl_set:Nx \l_dhkgraph_id_tl {\seq_item:Nn \l_dhkgraph_matches_seq {3}}
      \tl_set:Nn \l_dhkgraph_direction_tl {merge}}
     {\tl_clear:N \l_dhkgraph_tmp_tl}
   }
  \seq_set_split:NnV \l_dhkgraph_members_seq {,} \l_dhkgraph_tmp_tl
  \int_incr:N \l_dhkgraph_conn_int
  \tl_set:Nx \l_dhkgraph_a_tl {\seq_item:Nn \l_dhkgraph_members_seq {1}}
  \tl_trim_spaces:N \l_dhkgraph_a_tl
  \str_if_eq:VnTF \l_dhkgraph_direction_tl {split}
   {\coordinate (dhkg-rail-\int_use:N \l_dhkgraph_conn_int)
       at ($(dhkg-\l_dhkgraph_id_tl.south)!0.5!(dhkg-\l_dhkgraph_a_tl.north)$);
    \draw[line~width=.7pt]
     (dhkg-\l_dhkgraph_id_tl.south)--
     (dhkg-\l_dhkgraph_id_tl.south |- dhkg-rail-\int_use:N \l_dhkgraph_conn_int);
    \seq_map_inline:Nn \l_dhkgraph_members_seq
     {\tl_set:Nn \l_tmpa_tl {##1}\tl_trim_spaces:N \l_tmpa_tl
      \draw[line~width=.7pt,-{Stealth[length=2.3mm]}]
       (dhkg-\l_tmpa_tl.north |- dhkg-rail-\int_use:N \l_dhkgraph_conn_int)--
       (dhkg-\l_tmpa_tl.north);}
   }
   {\coordinate (dhkg-rail-\int_use:N \l_dhkgraph_conn_int)
       at ($(dhkg-\l_dhkgraph_a_tl.south)!0.5!(dhkg-\l_dhkgraph_id_tl.north)$);
    \seq_map_inline:Nn \l_dhkgraph_members_seq
     {\tl_set:Nn \l_tmpa_tl {##1}\tl_trim_spaces:N \l_tmpa_tl
      \draw[line~width=.7pt]
       (dhkg-\l_tmpa_tl.south)--
       (dhkg-\l_tmpa_tl.south |- dhkg-rail-\int_use:N \l_dhkgraph_conn_int);}
    \draw[line~width=.7pt,-{Stealth[length=2.3mm]}]
      (dhkg-\l_dhkgraph_id_tl.north |- dhkg-rail-\int_use:N \l_dhkgraph_conn_int)--
      (dhkg-\l_dhkgraph_id_tl.north);
   }
  % rail from first to last node, assuming nodes ordered left-to-right
  \tl_set:Nx \l_dhkgraph_b_tl {\seq_item:Nn \l_dhkgraph_members_seq {-1}}
  \tl_trim_spaces:N \l_dhkgraph_b_tl
  \draw[line~width=.7pt]
    (dhkg-\l_dhkgraph_a_tl.center |- dhkg-rail-\int_use:N \l_dhkgraph_conn_int)--
    (dhkg-\l_dhkgraph_b_tl.center |- dhkg-rail-\int_use:N \l_dhkgraph_conn_int);
 }
% v7: Draw a group only when all of its direct members have been
% drawn. This is a stable topological pass: unrelated groups retain order;
% an outer group may be declared before its inner group.
\cs_new_protected:Npn \dhkgraph_try_nested_group:n #1
 {
  \tl_set:Nn \l_dhkgraph_line_tl {#1}
  \dhkgraph_extract_marker:
  \regex_extract_once:nVNTF
   {\A group\s+([A-Za-z_][A-Za-z_0-9-]*)\s*\(([^)]*)\)}
   \l_dhkgraph_line_tl \l_dhkgraph_matches_seq
   {
    \tl_set:Nx \l_dhkgraph_nested_id_tl
     {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
    \tl_set:Nx \l_dhkgraph_nested_members_tl
     {\seq_item:Nn \l_dhkgraph_matches_seq {3}}
    \bool_set_true:N \l_dhkgraph_group_ready_bool
    \tl_if_blank:VT \l_dhkgraph_nested_members_tl
      {\bool_set_false:N \l_dhkgraph_group_ready_bool}
    \prop_if_in:NVT \l_dhkgraph_rendered_ids_prop
      \l_dhkgraph_nested_id_tl
      {\bool_set_false:N \l_dhkgraph_group_ready_bool}
    \seq_set_split:NnV \l_dhkgraph_members_seq {,}
      \l_dhkgraph_nested_members_tl
    \seq_map_inline:Nn \l_dhkgraph_members_seq
     {
      \tl_set:Nn \l_tmpa_tl {##1}
      \tl_trim_spaces:N \l_tmpa_tl
      \prop_if_in:NVF \l_dhkgraph_rendered_ids_prop \l_tmpa_tl
       {\bool_set_false:N \l_dhkgraph_group_ready_bool}
     }
    \bool_if:NTF \l_dhkgraph_group_ready_bool
     {
      \dhkgraph_draw_group:n {#1}
      \prop_put:NVn \l_dhkgraph_rendered_ids_prop
        \l_dhkgraph_nested_id_tl {1}
     }
     {\seq_put_right:Nn \l_dhkgraph_next_groups_seq {#1}}
   }
   {\PackageWarning{mynotes}{dhkgraph~bad~group~declaration}}
 }
\cs_new_protected:Npn \dhkgraph_render_nested_groups:
 {
  \prop_clear:N \l_dhkgraph_rendered_ids_prop
  \seq_map_inline:Nn \l_dhkgraph_nodes_seq
   {
    \regex_extract_once:nnNT
     {\A node\s+([A-Za-z_][A-Za-z_0-9-]*)\s*\(}
     {##1} \l_dhkgraph_matches_seq
     {
      \tl_set:Nx \l_tmpa_tl {\seq_item:Nn \l_dhkgraph_matches_seq {2}}
      \prop_put:NVn \l_dhkgraph_rendered_ids_prop \l_tmpa_tl {1}
     }
   }
  \seq_set_eq:NN \l_dhkgraph_pending_groups_seq \l_dhkgraph_groups_seq
  \int_step_inline:nn {\seq_count:N \l_dhkgraph_groups_seq}
   {
    \seq_clear:N \l_dhkgraph_next_groups_seq
    \seq_map_inline:Nn \l_dhkgraph_pending_groups_seq
      {\dhkgraph_try_nested_group:n {####1}}
    \seq_set_eq:NN \l_dhkgraph_pending_groups_seq
       \l_dhkgraph_next_groups_seq
   }
  \seq_map_inline:Nn \l_dhkgraph_pending_groups_seq
   {
    \PackageWarning{mynotes}
      {dhkgraph~unresolved~group:~missing~member,~duplicate~ID~or~cycle}
   }
 }

\cs_new_protected:Npn \dhkgraph_render:
 {
  \group_begin:
  \dhkgraph_prepare:
  \ior_open:Nn \g_dhkgraph_ior {\jobname-dhkgraph.tmp}
  \ior_str_map_inline:Nn \g_dhkgraph_ior {\dhkgraph_read_line:n {##1}}
  \ior_close:N \g_dhkgraph_ior
  \par\addvspace{2mm}
  \noindent\hspace*{\l_dhkgraph_indent_dim}%
  \begin{minipage}{\dim_eval:n{\linewidth-\l_dhkgraph_indent_dim}}
  \begin{tcolorbox}[width=\linewidth,
    colback=white,colframe=black!24,boxrule=.55pt,arc=3mm,
    left=3mm,right=3mm,top=4mm,bottom=3mm,
    before~skip=1mm,after~skip=2mm]
   \centering
   \begin{adjustbox}{max~width=\dim_eval:n{\linewidth-1mm}}
    \begin{tikzpicture}[>=Stealth,baseline=(current~bounding~box.center)]
     \dhkgraph_scan_groups:
     \bool_if:NT \l_dhkgraph_uniform_bool
       {\dhkgraph_scan_uniform_width:}
     \bool_set_true:N \l_dhkgraph_measuring_bool
     \seq_map_inline:Nn \l_dhkgraph_nodes_seq {\dhkgraph_draw_node:n {##1}}
     \bool_set_false:N \l_dhkgraph_measuring_bool
     \dhkgraph_build_grid:
     \seq_map_inline:Nn \l_dhkgraph_nodes_seq {\dhkgraph_draw_node:n {##1}}
     \dhkgraph_render_nested_groups:
     \seq_map_inline:Nn \l_dhkgraph_edges_seq {\dhkgraph_draw_connector:n {##1}}
     % v6: draw markers last. Their white backing keeps crossing edges
     % from running through the numbering. Only marked boxes are affected.
     \prop_map_inline:Nn \l_dhkgraph_node_markers_prop
        {\dhkgraph_draw_marker:nn {##1} {##2}}
     \prop_map_inline:Nn \l_dhkgraph_group_markers_prop
        {\dhkgraph_draw_marker:nn {##1} {##2}}
    \end{tikzpicture}
   \end{adjustbox}
   % v6: explanation is visually separate from the muted caption.
   \bool_if:NT \l_dhkgraph_explain_bool
    {\par\vspace{4mm}
     {\centering\small\bfseries
       \exp_args:NV \dhkgraph_show_text:n \l_dhkgraph_explain_tl\par}}
   \bool_if:NT \l_dhkgraph_caption_bool
    {\par\vspace{2mm}
     {\raggedright\color{black!60}\footnotesize
          \exp_args:NV \dhkgraph_show_text:n \l_dhkgraph_caption_tl\par}}
  \end{tcolorbox}
  \end{minipage}
  \par\addvspace{2mm}
  \group_end:
 }
\cs_new_eq:NN \dhkgraphrender \dhkgraph_render:
\ExplSyntaxOff
\newenvironment{dhkgraph}[1][]{%
  \VerbatimEnvironment
  \dhkgraphsetoption{#1}%
  \dhkvisualverbatimstart%
  \begin{VerbatimOut}{\jobname-dhkgraph.tmp}%
}{%
  \end{VerbatimOut}%
  \dhkgraphrender%
}


