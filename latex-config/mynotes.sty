   {\int_max:nn {\l_dhkbranch_max_int} {\l_dhkbranch_new_slot_tl}}
 }
\cs_generate_variant:Nn \prop_put:Nnn { NnV }
% Split one raw instruction into command/columns and literal label.
\cs_new_protected:Npn \dhkbranch_decode:n #1
 {
  \tl_set:Nn \l_dhkbranch_line_tl {#1}
  \tl_trim_spaces:N \l_dhkbranch_line_tl
  \tl_clear:N \l_dhkbranch_command_tl
  \tl_clear:N \l_dhkbranch_left_tl
  \tl_clear:N \l_dhkbranch_right_tl
  \tl_clear:N \l_dhkbranch_label_tl
  \bool_set_true:N \l_dhkbranch_horizontal_arrow_bool
  \tl_if_blank:VF \l_dhkbranch_line_tl
   {
    \tl_set:Nx \l_tmpa_tl {\tl_to_str:n {::}}
    \seq_set_split:NVV \l_dhkbranch_chunks_seq \l_tmpa_tl \l_dhkbranch_line_tl
    \seq_pop_left:NN \l_dhkbranch_chunks_seq \l_dhkbranch_line_tl
    \seq_if_empty:NF \l_dhkbranch_chunks_seq
     {\seq_pop_left:NN \l_dhkbranch_chunks_seq \l_dhkbranch_label_tl}
    \tl_trim_spaces:N \l_dhkbranch_label_tl
    \tl_trim_spaces:N \l_dhkbranch_line_tl
    \regex_extract_once:nVNTF
      {\A(branchline|branch|handoff)\s+([-A-Za-z0-9\_]+)\s*->\s*([-A-Za-z0-9\_]+)\Z}
      \l_dhkbranch_line_tl \l_dhkbranch_match_seq
     {
      \tl_set:Nx \l_dhkbranch_command_tl {\seq_item:Nn \l_dhkbranch_match_seq {2}}
      \tl_set:Nx \l_dhkbranch_left_tl {\seq_item:Nn \l_dhkbranch_match_seq {3}}
      \tl_set:Nx \l_dhkbranch_right_tl {\seq_item:Nn \l_dhkbranch_match_seq {4}}
      \str_case:Vn \l_dhkbranch_command_tl
       {
        {branchline}
         {\tl_set:Nn \l_dhkbranch_command_tl {branch}
          \bool_set_false:N \l_dhkbranch_horizontal_arrow_bool}
        {handoff} {\bool_set_false:N \l_dhkbranch_horizontal_arrow_bool}
       }
     }
     {
      \regex_extract_once:nVNTF
       {\A(node|line|arrow|arrowup|stop)\s+([-A-Za-z0-9\_]+)\Z}
       \l_dhkbranch_line_tl \l_dhkbranch_match_seq
       {
        \tl_set:Nx \l_dhkbranch_command_tl {\seq_item:Nn \l_dhkbranch_match_seq {2}}
        \tl_set:Nx \l_dhkbranch_left_tl {\seq_item:Nn \l_dhkbranch_match_seq {3}}
       }
       {\PackageWarning{mynotes}{Ignoring~invalid~dhkbranch~line}}
     }
   }
 }
% First pass: find the widest simultaneous set of lanes.
\cs_new_protected:Npn \dhkbranch_scan:n #1
 {
  \dhkbranch_decode:n {#1}
  \str_case:Vn \l_dhkbranch_command_tl
   {
    {branch}
     {
      \prop_get:NVNTF \l_dhkbranch_lanes_prop \l_dhkbranch_left_tl \l_tmpa_tl
       {
        \prop_get:NVNTF \l_dhkbranch_lanes_prop \l_dhkbranch_right_tl \l_tmpb_tl
         {} {\exp_args:NV \dhkbranch_allocate:n \l_dhkbranch_right_tl}
       } {}
     }
    {handoff}
    {
     \prop_get:NVNTF \l_dhkbranch_lanes_prop \l_dhkbranch_left_tl \l_tmpa_tl
      {
       \prop_get:NVNTF \l_dhkbranch_lanes_prop \l_dhkbranch_right_tl \l_tmpb_tl
        {} {\exp_args:NV \dhkbranch_allocate:n \l_dhkbranch_right_tl}
       \str_if_eq:VnF \l_dhkbranch_left_tl {main}
        {\seq_put_right:NV \l_dhkbranch_free_seq \l_tmpa_tl}
       \prop_remove:NV \l_dhkbranch_lanes_prop \l_dhkbranch_left_tl
      }{}
    }
   {stop}
     {
      \prop_get:NVNTF \l_dhkbranch_lanes_prop \l_dhkbranch_left_tl \l_tmpa_tl
       {
        \str_if_eq:VnF \l_dhkbranch_left_tl {main}
         {
          \seq_put_right:NV \l_dhkbranch_free_seq \l_tmpa_tl
          \prop_remove:NV \l_dhkbranch_lanes_prop \l_dhkbranch_left_tl
         }
       } {}
     }
   }
 }
% ==================================================
% 8.5 Main trunk fixed at x=0; branch and handoff connections
% ==================================================
% Main trunk: fixed x=0; branch slots: 9mm apart.
% Only one instruction/label occupies a given row; labels may
% use the full remaining text width, not a tiny per-lane cell.
%
\dim_new:N \l_dhkbranch_label_width_dim
\tl_new:N \l_dhkbranch_label_slot_tl
% The // syntax is unchanged.  "//*" adds an indented child line.
% It is drawn inside the existing label box, so row heights and gaps
% are still computed from the final typeset node dimensions.
\cs_new_protected:Npn \dhkbranch_normal_part:n #1
 {
  \seq_set_split:Nnn \l_dhkbranch_label_lines_seq {//} {#1}
  \seq_map_indexed_inline:Nn \l_dhkbranch_label_lines_seq
   {
    \int_compare:nNnT {##1} > {1} {\kern 1mm}
    \tl_set:Nn \l_tmpb_tl {##2}
    \tl_trim_spaces:N \l_tmpb_tl
    \hbox{\ttfamily\small\tl_use:N \l_tmpb_tl}
   }
 }
\cs_new_protected:Npn \dhkbranch_child_part:n #1
 {
  \seq_set_split:Nnn \l_dhkbranch_label_lines_seq {//} {#1}
  \seq_map_indexed_inline:Nn \l_dhkbranch_label_lines_seq
   {
    \kern 1mm
    \tl_set:Nn \l_tmpb_tl {##2}
    \tl_trim_spaces:N \l_tmpb_tl
    \hbox{\kern 1mm
      \tikz[baseline=-0.3ex]{\draw[thin] (0,1.2ex)--(0,0)--(2mm,0);}%
      \kern 0.75mm\ttfamily\small\tl_use:N \l_tmpb_tl}
   }
 }
\cs_new_protected:Npn \dhkbranch_child_label:
 {
  \seq_set_split:NnV \l_dhkbranch_child_parts_seq {//*} \l_dhkbranch_label_tl
  \seq_map_indexed_inline:Nn \l_dhkbranch_child_parts_seq
   {
    \int_compare:nNnTF {##1} = {1}
     {\dhkbranch_normal_part:n {##2}}
     {\dhkbranch_child_part:n {##2}}
   }
 }
\cs_new_protected:Npn \dhkbranch_prepare_row:
 {
  \tl_set_eq:NN \l_dhkbranch_label_slot_tl \l_dhkbranch_left_tl
  \str_if_eq:VnT \l_dhkbranch_command_tl {branch}
   {\tl_set_eq:NN \l_dhkbranch_label_slot_tl \l_dhkbranch_right_tl}
  \str_if_eq:VnT \l_dhkbranch_command_tl {handoff}
   {\tl_set_eq:NN \l_dhkbranch_label_slot_tl \l_dhkbranch_right_tl}
  \tl_set:Nn \l_tmpa_tl {0}
  \prop_get:NVNTF \l_dhkbranch_lanes_prop
    \l_dhkbranch_label_slot_tl \l_tmpa_tl {} {}
  \dim_set:Nn \l_dhkbranch_label_width_dim
    {\linewidth - \l_tmpa_tl \l_dhkbranch_gap_dim - 11mm - \l_dhkbranch_indentation_dim}
  \dim_set:Nn \l_dhkbranch_label_width_dim
    {\dim_max:nn {22mm} {\l_dhkbranch_label_width_dim}}
  % A label may contain //, just like dhktree.  Each segment is
  % a separate line in ONE stage box (not separate graph rows).
  % Single-line labels retain the original v7 box dimensions.
  \tl_set:Nx \l_tmpa_tl {\tl_to_str:n {//}}
  \seq_set_split:NVV \l_dhkbranch_label_lines_seq
    \l_tmpa_tl \l_dhkbranch_label_tl
  \tl_if_in:VnTF \l_dhkbranch_label_tl {//*}
   {\vbox_set:Nn \l_dhkbranch_label_box
     {\offinterlineskip\dhkbranch_child_label:}}
   {
  \int_compare:nNnTF {\seq_count:N \l_dhkbranch_label_lines_seq} = {1}
   {
    \hbox_set:Nn \l_dhkbranch_label_box
      {\ttfamily\small\tl_use:N \l_dhkbranch_label_tl}
   }
   {
    % Natural-width vertical box; 1mm between explicit lines.
    \vbox_set:Nn \l_dhkbranch_label_box
     {
      \offinterlineskip
      \seq_map_indexed_inline:Nn \l_dhkbranch_label_lines_seq
       {
        \int_compare:nNnT {##1} > {1} {\kern 1mm}
        \tl_set:Nn \l_tmpb_tl {##2}
        \tl_trim_spaces:N \l_tmpb_tl
        \hbox{\ttfamily\small\tl_use:N \l_tmpb_tl}
       }
     }
   }
   }
  % Wrap only when the whole label would exceed the usable page width.
  % This also supports // inside an unusually long label.
  \dim_compare:nNnT
    {\box_wd:N \l_dhkbranch_label_box}
    > {\l_dhkbranch_label_width_dim}
   {
    \hbox_set:Nn \l_dhkbranch_label_box
     {
      \begin{minipage}{\l_dhkbranch_label_width_dim}
       \raggedright\ttfamily\small
       \tl_if_in:VnTF \l_dhkbranch_label_tl {//*}
        {\par\noindent\vbox{\offinterlineskip\dhkbranch_child_label:}}
        {
       \seq_map_indexed_inline:Nn \l_dhkbranch_label_lines_seq
        {
         \int_compare:nNnT {##1} > {1} {\par\vspace{1mm}\noindent}
         \tl_set:Nn \l_tmpb_tl {##2}
         \tl_trim_spaces:N \l_tmpb_tl
         \tl_use:N \l_tmpb_tl
        }
        }
      \end{minipage}
     }
   }
  \dim_set:Nn \l_dhkbranch_row_dim
   {\dim_max:nn {5.5mm}
       {\box_ht:N \l_dhkbranch_label_box
         + \box_dp:N \l_dhkbranch_label_box + 3.2mm}}
  \dim_set:Nn \l_dhkbranch_node_top_dim
   {0.5\l_dhkbranch_row_dim - 0.5\box_ht:N \l_dhkbranch_label_box
    - 0.5\box_dp:N \l_dhkbranch_label_box - 0.6mm}
  \dim_set:Nn \l_dhkbranch_node_bottom_dim
   {0.5\l_dhkbranch_row_dim + 0.5\box_ht:N \l_dhkbranch_label_box
    + 0.5\box_dp:N \l_dhkbranch_label_box + 0.6mm}
  \str_case:Vn \l_dhkbranch_command_tl
   {
    {arrow}{\dim_set:Nn \l_dhkbranch_row_dim {4.7mm}}
    {arrowup}{\dim_set:Nn \l_dhkbranch_row_dim {4.7mm}}
    {branch}{\dim_set:Nn \l_dhkbranch_row_dim {8.7mm}}
    {handoff}{\dim_set:Nn \l_dhkbranch_row_dim {8.7mm}}
   }
 }
% ==================================================
% 8.6 STEP interrupts only its own vertical line, ACTION stays to right.
% ==================================================
\cs_new_protected:Npn \dhkbranch_picture:
 {
  \par\noindent
  \hbox to \linewidth
   {
    \begin{tikzpicture}[x=\l_dhkbranch_gap_dim,y=1mm]
      \path[use~as~bounding~box] (0,0)
        rectangle (\linewidth,-\l_dhkbranch_row_dim);
      \begin{scope}[xshift=\dim_eval:n {9mm + \l_dhkbranch_indentation_dim}]
      % Active vertical trunks; step nodes leave a clear text-only gap.
      % No tiny line is drawn immediately above or below a node.
      \prop_map_inline:Nn \l_dhkbranch_lanes_prop
       {
        \bool_set_true:N \l_dhkbranch_valid_bool
        \str_if_eq:VnT \l_dhkbranch_command_tl {branch}
         {\str_if_eq:eeT {##1} {\l_dhkbranch_right_tl}
           {\bool_set_false:N \l_dhkbranch_valid_bool}}
        \str_if_eq:VnT \l_dhkbranch_command_tl {handoff}
         {\str_if_eq:eeT {##1} {\l_dhkbranch_left_tl}
           {\bool_set_false:N \l_dhkbranch_valid_bool}
          \str_if_eq:eeT {##1} {\l_dhkbranch_right_tl}
           {\bool_set_false:N \l_dhkbranch_valid_bool}}
        \str_if_eq:VnT \l_dhkbranch_command_tl {stop}
         {\str_if_eq:eeT {##1} {\l_dhkbranch_left_tl}
           {\bool_set_false:N \l_dhkbranch_valid_bool}}
        \bool_if:NT \l_dhkbranch_valid_bool
         {
          \str_if_eq:VnTF \l_dhkbranch_command_tl {node}
           {
            \str_if_eq:eeF {##1} {\l_dhkbranch_left_tl}
             {\draw[thin] (##2,0) -- (##2,-\l_dhkbranch_row_dim);}
           }
           {
            \str_case:VnF \l_dhkbranch_command_tl
             {
              {arrow}
               {
                \str_if_eq:eeTF {##1} {\l_dhkbranch_left_tl}
                 {\draw[thin,-{Stealth[length=1.5mm]}]
                   (##2,0) -- (##2,-\l_dhkbranch_row_dim);}
                 {\draw[thin] (##2,0) -- (##2,-\l_dhkbranch_row_dim);}
               }
              {arrowup}
               {
                \str_if_eq:eeTF {##1} {\l_dhkbranch_left_tl}
                 {\draw[thin,-{Stealth[length=1.5mm]}]
                   (##2,-\l_dhkbranch_row_dim) -- (##2,0);}
                 {\draw[thin] (##2,0) -- (##2,-\l_dhkbranch_row_dim);}
               }
             }
             {\draw[thin] (##2,0) -- (##2,-\l_dhkbranch_row_dim);}
           }
         }
       }
      % Handoff cuts the old trunk at its final horizontal branch.
      \str_if_eq:VnT \l_dhkbranch_command_tl {handoff}
       {\prop_get:NVNTF \l_dhkbranch_lanes_prop \l_dhkbranch_left_tl \l_tmpa_tl
         {\draw[thin] (\l_tmpa_tl,0) -- (\l_tmpa_tl,-6.2mm);} {}}
      % Branch is a horizontal connector to the LEFT edge of its label.
      % No elbow: the child's vertical spine is used only by subsequent
      % arrow/line/node rows, and is independent of the horizontal connector.
      % Constant length for each reused branch slot.
      \str_if_eq:VnT \l_dhkbranch_command_tl {branch}
       {
        \prop_get:NVNTF \l_dhkbranch_lanes_prop
          \l_dhkbranch_left_tl \l_tmpa_tl
         {
          \prop_get:NVNTF \l_dhkbranch_lanes_prop
            \l_dhkbranch_right_tl \l_tmpb_tl
           {
            \bool_if:NTF \l_dhkbranch_horizontal_arrow_bool
             {\draw[thin,-{Stealth[length=1.5mm]}]
               (\l_tmpa_tl,-6.2mm) --
               ([xshift=-2.5mm]\l_tmpb_tl,-6.2mm);}
             {\draw[thin]
               (\l_tmpa_tl,-6.2mm) --
               ([xshift=-2.5mm]\l_tmpb_tl,-6.2mm);}
           }{}
         }{}
       }
      \str_if_eq:VnT \l_dhkbranch_command_tl {handoff}
       {
        \prop_get:NVNTF \l_dhkbranch_lanes_prop
          \l_dhkbranch_left_tl \l_tmpa_tl
         {
          \prop_get:NVNTF \l_dhkbranch_lanes_prop
            \l_dhkbranch_right_tl \l_tmpb_tl
           {
            \bool_if:NTF \l_dhkbranch_horizontal_arrow_bool
             {\draw[thin,-{Stealth[length=1.5mm]}]
               (\l_tmpa_tl,-6.2mm) --
               ([xshift=-2.5mm]\l_tmpb_tl,-6.2mm);}
             {\draw[thin]
               (\l_tmpa_tl,-6.2mm) --
               ([xshift=-2.5mm]\l_tmpb_tl,-6.2mm);}
           }{}
         }{}
       }
      % STEP = text in the interrupted column, ACTION = right of line.
      % Branch caption is horizontally CENTERED on its own column,
      % not offset to the right as an annotation.
      \tl_if_blank:VF \l_dhkbranch_label_tl
       {
        \prop_get:NVNTF \l_dhkbranch_lanes_prop
          \l_dhkbranch_label_slot_tl \l_tmpa_tl
         {
          \str_case:VnF \l_dhkbranch_command_tl
           {
            {branch}
             {
              % Always left-align the FIRST branch label at the fixed
              % horizontal connector endpoint.  Longer text extends right,
              % never into the main trunk.  The child spine stays fixed.
              \node[anchor=west,inner~sep=0pt,fill=white,xshift=-1.5mm]
                at (\l_tmpa_tl,-6.2mm)
                {\box_use:N \l_dhkbranch_label_box};
             }
            {handoff}
             {
              % Always left-align the FIRST branch label at the fixed
              % horizontal connector endpoint.  Longer text extends right,
              % never into the main trunk.  The child spine stays fixed.
              \node[anchor=west,inner~sep=0pt,fill=white,xshift=-1.5mm]
                at (\l_tmpa_tl,-6.2mm)
                {\box_use:N \l_dhkbranch_label_box};
             }
            {node}
             {
              \str_if_eq:VnTF \l_dhkbranch_left_tl {main}
               {\node[anchor=west,inner~sep=0pt,fill=white,xshift=-6mm]
                 at (\l_tmpa_tl,-0.5\l_dhkbranch_row_dim)
                 {\box_use:N \l_dhkbranch_label_box};}
               {
               % Short follow-up stages center on the same child spine.
               % Long labels extend right to keep them clear of main.
               \dim_compare:nNnTF
                 {\box_wd:N \l_dhkbranch_label_box} > {1.7\l_dhkbranch_gap_dim}
                {\node[anchor=west,inner~sep=0pt,fill=white,xshift=-1.5mm]
                  at (\l_tmpa_tl,-0.5\l_dhkbranch_row_dim)
                  {\box_use:N \l_dhkbranch_label_box};}
                {\node[anchor=center,inner~sep=0pt,fill=white]
                  at (\l_tmpa_tl,-0.5\l_dhkbranch_row_dim)
                  {\box_use:N \l_dhkbranch_label_box};}
              }
             }
           }
           {\node[anchor=west,inner~sep=0pt,xshift=3mm]
              at (\l_tmpa_tl,-0.5\l_dhkbranch_row_dim)
              {\box_use:N \l_dhkbranch_label_box};}
         }{}
       }
      \end{scope}
    \end{tikzpicture}
    \hss
   }
  \par
 }
% ==================================================
% 8.7 Parse and typeset one row
% ==================================================
\cs_new_protected:Npn \dhkbranch_draw:nn #1#2
 {
  \dhkbranch_decode:n {#1}
  % Only the terminating node has no outgoing tail.  A following
  % 'stop lane' or the end of the environment terminates that lane.
  \bool_set_false:N \l_dhkbranch_terminal_node_bool
  \str_if_eq:VnT \l_dhkbranch_command_tl {node}
   {
    \tl_set:Nx \l_tmpa_tl {#2}
    \tl_trim_spaces:N \l_tmpa_tl
    \tl_set:Nx \l_tmpb_tl {stop\c_space_tl\l_dhkbranch_left_tl}
    \tl_if_eq:NNT \l_tmpa_tl \l_tmpb_tl
     {\bool_set_true:N \l_dhkbranch_terminal_node_bool}
    \tl_if_blank:VT \l_tmpa_tl
     {\bool_set_true:N \l_dhkbranch_terminal_node_bool}
   }
  \tl_if_blank:VF \l_dhkbranch_command_tl
   {
    \str_if_eq:VnTF \l_dhkbranch_command_tl {stop}
     {
      % End a child without adding an unintended extra row or arrow.
      \prop_get:NVNTF \l_dhkbranch_lanes_prop
        \l_dhkbranch_left_tl \l_tmpa_tl
       {
        \str_if_eq:VnF \l_dhkbranch_left_tl {main}
         {
          \seq_put_right:NV \l_dhkbranch_free_seq \l_tmpa_tl
          \prop_remove:NV \l_dhkbranch_lanes_prop \l_dhkbranch_left_tl
         }
       }{}
     }
     {
      \str_if_eq:VnT \l_dhkbranch_command_tl {branch}
       {
        \prop_get:NVNTF \l_dhkbranch_lanes_prop
          \l_dhkbranch_left_tl \l_tmpa_tl
         {
          \prop_get:NVNTF \l_dhkbranch_lanes_prop
            \l_dhkbranch_right_tl \l_tmpb_tl
           {} {\exp_args:NV \dhkbranch_allocate:n \l_dhkbranch_right_tl}
         }{}
       }
      \str_if_eq:VnT \l_dhkbranch_command_tl {handoff}
       {
        \prop_get:NVNTF \l_dhkbranch_lanes_prop
          \l_dhkbranch_left_tl \l_tmpa_tl
         {
          \prop_get:NVNTF \l_dhkbranch_lanes_prop
            \l_dhkbranch_right_tl \l_tmpb_tl
           {} {\exp_args:NV \dhkbranch_allocate:n \l_dhkbranch_right_tl}
         }{}
       }
      \dhkbranch_prepare_row:
      \dhkbranch_picture:
      \str_if_eq:VnT \l_dhkbranch_command_tl {handoff}
       {\prop_get:NVNTF \l_dhkbranch_lanes_prop \l_dhkbranch_left_tl \l_tmpa_tl
         {\str_if_eq:VnF \l_dhkbranch_left_tl {main}
           {\seq_put_right:NV \l_dhkbranch_free_seq \l_tmpa_tl}
          \prop_remove:NV \l_dhkbranch_lanes_prop \l_dhkbranch_left_tl} {}}
      \bool_set_false:N \l_dhkbranch_first_row_bool
     }
   }
 }
% ==================================================
% 8.8 Main render; naturally page-breakable at row boundaries
% ==================================================
\cs_new_protected:Npn \dhkbranch_render:
 {
  \group_begin:
  \int_zero:N \l_dhkbranch_max_int
  \dhkbranch_reset:
  \dim_set:Nn \l_dhkbranch_gap_dim {9mm}
  \dim_zero:N \l_dhkbranch_indentation_dim
  \tl_set_eq:NN \l_tmpa_tl \g_dhkbranch_option_tl
  \tl_trim_spaces:N \l_tmpa_tl
  \regex_extract_once:nVNTF
    {\A in \s* = \s* ([0-9]+ (?: \. [0-9]+ )?) \Z}
    \l_tmpa_tl \l_dhkbranch_option_match_seq
   {
    \dim_set:Nn \l_dhkbranch_indentation_dim
     {\seq_item:Nn \l_dhkbranch_option_match_seq {2} em}
   }
   {
    \tl_if_eq:VnTF \l_tmpa_tl {indent}
     {\dim_set_eq:NN \l_dhkbranch_indentation_dim \g_dhkbranch_indent_amount_dim}
     {\tl_if_blank:VF \l_tmpa_tl
       {\PackageWarning{mynotes}{Unknown~dhkbranch~option;~use~[in=5]}}}
   }
  \seq_clear:N \l_dhkbranch_lines_seq
  \ior_open:Nn \g_dhkbranch_source_ior {\jobname-dhkbranch.tmp}
  \ior_str_map_inline:Nn \g_dhkbranch_source_ior
   {
    \tl_set:Nn \l_tmpa_tl {##1}
    \tl_trim_spaces:N \l_tmpa_tl
    \tl_if_blank:VF \l_tmpa_tl
     {
      \seq_put_right:NV \l_dhkbranch_lines_seq \l_tmpa_tl
      \exp_args:NV \dhkbranch_scan:n \l_tmpa_tl
     }
   }
  \ior_close:N \g_dhkbranch_source_ior
  \dhkbranch_reset:
  \par\addvspace{3mm}
  \bool_set_true:N \l_dhkbranch_first_row_bool
  \group_begin:
  \parskip=0pt\parindent=0pt\baselineskip=0pt
  \seq_map_indexed_inline:Nn \l_dhkbranch_lines_seq
   {
    \dhkbranch_draw:nn {##2}
     {\seq_item:Nn \l_dhkbranch_lines_seq {\int_eval:n {##1+1}}}
   }
  \group_end:
  \par\addvspace{3mm}
  \group_end:
 }
